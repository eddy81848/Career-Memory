{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://synthetic.example.test/schemas/career-memory/claim-pipeline-synthetic-golden-v0.3.0.json",
  "title": "Career Memory T-004A/B Grounded Claim Pipeline Synthetic Regression Dataset Schema (v0.3.0-synthetic-golden)",
  "description": "Structural schema for the approved synthetic regression test dataset (v0.3.0-synthetic-golden, approved from v0.3.0-draft @ 5700674). Scope is strictly limited to synthetic regression tests; live LLM evaluation, external connector integration, and unverified REF items (REF-04/05 partial gaps, REF-06..08 coverage gaps) remain excluded. Normalization, locator, and product status enum mappings remain REVIEW_REQUIRED for production.",
  "$defs": {
    "Sha256Hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "Locator": {
      "type": "object",
      "required": [
        "locator_id",
        "locator_spec_version",
        "normalization_policy",
        "convention_scope",
        "char_start",
        "char_end",
        "char_length",
        "utf8_byte_start",
        "utf8_byte_end",
        "utf8_byte_length",
        "utf16_start",
        "utf16_end",
        "line_start",
        "line_end",
        "span_sha256"
      ],
      "additionalProperties": false,
      "properties": {
        "locator_id": { "type": "string", "minLength": 5 },
        "locator_spec_version": { "type": "string", "const": "fixture-locator-v0-draft" },
        "normalization_policy": { "type": "string", "const": "fixture-nfc-lf-v0-draft" },
        "convention_scope": { "type": "string", "const": "TEST_FIXTURE_ONLY" },
        "char_start": { "type": "integer", "minimum": 0 },
        "char_end": { "type": "integer", "minimum": 1 },
        "char_length": { "type": "integer", "minimum": 1 },
        "utf8_byte_start": { "type": "integer", "minimum": 0 },
        "utf8_byte_end": { "type": "integer", "minimum": 1 },
        "utf8_byte_length": { "type": "integer", "minimum": 1 },
        "utf16_start": { "type": "integer", "minimum": 0 },
        "utf16_end": { "type": "integer", "minimum": 1 },
        "line_start": { "type": "integer", "minimum": 1 },
        "line_end": { "type": "integer", "minimum": 1 },
        "span_sha256": { "$ref": "#/$defs/Sha256Hash" }
      }
    },
    "SourceRevision": {
      "type": "object",
      "required": [
        "source_revision_id",
        "scenario_ids",
        "source_key",
        "revision_seq",
        "source_kind",
        "synthetic_uri",
        "language",
        "author_label",
        "author_identity_confidence",
        "created_at",
        "normalization_policy",
        "content_sha256",
        "char_length",
        "utf8_byte_length",
        "is_synthetic_fixture",
        "deleted_by_user",
        "raw_text_fixture_only"
      ],
      "additionalProperties": false,
      "properties": {
        "source_revision_id": { "type": "string", "pattern": "^rev-" },
        "scenario_ids": {
          "type": "array",
          "items": { "type": "string", "pattern": "^(SCN-[0-9]{2}|REF-0[1-8])$" }
        },
        "source_key": { "type": "string", "minLength": 2 },
        "revision_seq": { "type": "integer", "minimum": 1 },
        "source_kind": {
          "type": "string",
          "enum": [
            "SYNTHETIC_PR_SUMMARY",
            "SYNTHETIC_MEETING_NOTE",
            "SYNTHETIC_POSTMORTEM",
            "SYNTHETIC_DESIGN_DOC",
            "SYNTHETIC_RFC_PLAN",
            "SYNTHETIC_RETRO_NOTE",
            "SYNTHETIC_BENCHMARK_NOTE",
            "SYNTHETIC_LAUNCH_UPDATE",
            "SYNTHETIC_ISSUE_COMMENT"
          ]
        },
        "synthetic_uri": { "type": "string", "pattern": "^https://synthetic\\.example\\.test/" },
        "language": { "type": "string", "enum": ["en", "ko", "mixed"] },
        "author_label": { "type": "string", "minLength": 1 },
        "author_identity_confidence": {
          "type": "string",
          "enum": ["VERIFIED_OWNER", "TEAM_SHARED", "AMBIGUOUS"]
        },
        "created_at": { "type": "string", "minLength": 10 },
        "normalization_policy": { "type": "string", "const": "fixture-nfc-lf-v0-draft" },
        "content_sha256": { "$ref": "#/$defs/Sha256Hash" },
        "char_length": { "type": "integer", "minimum": 1 },
        "utf8_byte_length": { "type": "integer", "minimum": 1 },
        "is_synthetic_fixture": { "type": "boolean", "const": true },
        "deleted_by_user": { "type": "boolean" },
        "contains_canary": { "type": "boolean" },
        "canary_token_id": { "type": ["string", "null"] },
        "raw_text_fixture_only": { "type": "string", "minLength": 1 }
      }
    },
    "SourceRevisionsFile": {
      "type": "object",
      "required": [
        "schema_version",
        "dataset_version",
        "artifact_role",
        "normalization_policy",
        "convention_scope",
        "review_required_specs",
        "source_revisions"
      ],
      "additionalProperties": false,
      "properties": {
        "schema_version": { "type": "string", "const": "0.3.0-synthetic-golden" },
        "dataset_version": { "type": "string", "const": "0.3.0-synthetic-golden" },
        "artifact_role": { "type": "string", "const": "SYNTHETIC_SOURCE_INPUT" },
        "normalization_policy": { "type": "string", "const": "fixture-nfc-lf-v0-draft" },
        "convention_scope": { "type": "string", "const": "TEST_FIXTURE_ONLY" },
        "review_required_specs": { "type": "array", "items": { "type": "string" } },
        "source_revisions": {
          "type": "array",
          "items": { "$ref": "#/$defs/SourceRevision" }
        }
      }
    },
    "ContentUnit": {
      "type": "object",
      "required": [
        "content_unit_id",
        "scenario_id",
        "source_revision_id",
        "unit_index",
        "unit_type",
        "locator",
        "unit_sha256",
        "persists_raw_text"
      ],
      "additionalProperties": false,
      "properties": {
        "content_unit_id": { "type": "string", "pattern": "^cu-" },
        "scenario_id": { "type": "string", "pattern": "^(SCN-[0-9]{2}|REF-0[1-8])$" },
        "source_revision_id": { "type": "string", "pattern": "^rev-" },
        "unit_index": { "type": "integer", "minimum": 0 },
        "unit_type": {
          "type": "string",
          "enum": ["PARAGRAPH", "BULLET_ITEM", "SECTION_NOTE", "COMMENT_BLOCK"]
        },
        "locator": { "$ref": "#/$defs/Locator" },
        "unit_sha256": { "$ref": "#/$defs/Sha256Hash" },
        "persists_raw_text": { "type": "boolean", "const": false }
      }
    },
    "Stage1ContentUnitsFile": {
      "type": "object",
      "required": [
        "schema_version",
        "dataset_version",
        "stage_name",
        "stage_responsibility",
        "artifact_role",
        "content_units"
      ],
      "additionalProperties": false,
      "properties": {
        "schema_version": { "type": "string", "const": "0.3.0-synthetic-golden" },
        "dataset_version": { "type": "string", "const": "0.3.0-synthetic-golden" },
        "stage_name": { "type": "string", "const": "STAGE_1_CONTENT_UNIT_SEGMENTATION" },
        "stage_responsibility": { "type": "string", "minLength": 10 },
        "artifact_role": { "type": "string", "const": "STAGE_STUB_OUTPUT" },
        "content_units": {
          "type": "array",
          "items": { "$ref": "#/$defs/ContentUnit" }
        }
      }
    },
    "FactSupport": {
      "type": "object",
      "required": [
        "fact_support_id",
        "scenario_id",
        "canonical_fact_id",
        "source_revision_id",
        "content_unit_id",
        "support_role",
        "locator",
        "persists_raw_text"
      ],
      "additionalProperties": false,
      "properties": {
        "fact_support_id": { "type": "string", "pattern": "^fs-" },
        "scenario_id": { "type": "string", "pattern": "^SCN-[0-9]{2}$" },
        "canonical_fact_id": { "type": "string", "pattern": "^fact-" },
        "source_revision_id": { "type": "string", "pattern": "^rev-" },
        "content_unit_id": { "type": "string", "pattern": "^cu-" },
        "support_role": { "type": "string", "enum": ["DIRECT", "CONTEXT", "CONTRADICTS"] },
        "locator": { "$ref": "#/$defs/Locator" },
        "persists_raw_text": { "type": "boolean", "const": false }
      }
    },
    "CanonicalFact": {
      "type": "object",
      "required": [
        "canonical_fact_id",
        "scenario_id",
        "fact_text",
        "fact_category",
        "modality",
        "environment_scope",
        "attribution_scope",
        "identity_status",
        "deleted_by_user"
      ],
      "additionalProperties": false,
      "properties": {
        "canonical_fact_id": { "type": "string", "pattern": "^fact-" },
        "scenario_id": { "type": "string", "pattern": "^SCN-[0-9]{2}$" },
        "fact_text": { "type": "string", "minLength": 5 },
        "fact_category": {
          "type": "string",
          "enum": [
            "ENGINEERING_DELIVERY",
            "INCIDENT_RECORD",
            "PLAN_OR_PROPOSAL",
            "NEGATIVE_OUTCOME",
            "BENCHMARK_RESULT",
            "LAUNCH_EVENT",
            "CORRECTION_NOTICE",
            "PROJECT_CONTEXT"
          ]
        },
        "modality": { "type": "string", "enum": ["COMPLETED", "PLANNED", "NEGATED", "OBSERVED_CORRELATION"] },
        "environment_scope": { "type": "string", "enum": ["PRODUCTION", "STAGING_TEST", "UNSPECIFIED"] },
        "attribution_scope": { "type": "string", "enum": ["INDIVIDUAL", "TEAM", "AMBIGUOUS", "UNSPECIFIED"] },
        "identity_status": { "type": "string", "enum": ["RESOLVED", "AMBIGUOUS"] },
        "deleted_by_user": { "type": "boolean" }
      }
    },
    "Stage2FactExtractionFile": {
      "type": "object",
      "required": [
        "schema_version",
        "dataset_version",
        "stage_name",
        "stage_responsibility",
        "artifact_role",
        "scenario_fact_counts",
        "canonical_facts",
        "fact_supports"
      ],
      "additionalProperties": false,
      "properties": {
        "schema_version": { "type": "string", "const": "0.3.0-synthetic-golden" },
        "dataset_version": { "type": "string", "const": "0.3.0-synthetic-golden" },
        "stage_name": { "type": "string", "const": "STAGE_2_FACT_EXTRACTION" },
        "stage_responsibility": { "type": "string", "minLength": 10 },
        "artifact_role": { "type": "string", "const": "STAGE_STUB_OUTPUT" },
        "scenario_fact_counts": { "type": "object" },
        "canonical_facts": {
          "type": "array",
          "items": { "$ref": "#/$defs/CanonicalFact" }
        },
        "fact_supports": {
          "type": "array",
          "items": { "$ref": "#/$defs/FactSupport" }
        }
      }
    },
    "ClaimAtomSupport": {
      "type": "object",
      "required": [
        "claim_atom_support_id",
        "scenario_id",
        "claim_atom_id",
        "canonical_fact_id",
        "support_role",
        "evaluated_on_claim_version",
        "removed_by_user"
      ],
      "additionalProperties": false,
      "properties": {
        "claim_atom_support_id": { "type": "string", "pattern": "^cas-" },
        "scenario_id": { "type": "string", "pattern": "^SCN-[0-9]{2}$" },
        "claim_atom_id": { "type": "string", "pattern": "^atom-" },
        "canonical_fact_id": { "type": "string", "pattern": "^fact-" },
        "support_role": { "type": "string", "enum": ["DIRECT", "CONTEXT", "CONTRADICTS"] },
        "evaluated_on_claim_version": { "type": "integer", "minimum": 1 },
        "removed_by_user": { "type": "boolean" }
      }
    },
    "ClaimAtom": {
      "type": "object",
      "required": [
        "claim_atom_id",
        "scenario_id",
        "claim_id",
        "atom_text",
        "atom_kind",
        "is_required_atom",
        "user_edited",
        "is_hard_negative"
      ],
      "additionalProperties": false,
      "properties": {
        "claim_atom_id": { "type": "string", "pattern": "^atom-" },
        "scenario_id": { "type": "string", "pattern": "^SCN-[0-9]{2}$" },
        "claim_id": { "type": "string", "pattern": "^claim-" },
        "atom_text": { "type": "string", "minLength": 5 },
        "atom_kind": {
          "type": "string",
          "enum": ["ACTION", "OUTCOME_METRIC", "SCOPE_ENVIRONMENT", "ATTRIBUTION", "TIMING"]
        },
        "is_required_atom": { "type": "boolean" },
        "user_edited": { "type": "boolean" },
        "edit_severity": { "type": ["string", "null"], "enum": ["NONE", "MINOR_PARAPHRASE", "SUBSTANTIVE", null] },
        "is_hard_negative": { "type": "boolean" },
        "hard_negative_type": { "type": ["string", "null"] }
      }
    },
    "Claim": {
      "type": "object",
      "required": [
        "claim_id",
        "scenario_id",
        "claim_version",
        "previous_claim_version",
        "claim_text",
        "claim_atom_ids",
        "user_edited",
        "reverification_state_on_new_version",
        "user_edit_history",
        "derived_from_claim_ids"
      ],
      "additionalProperties": false,
      "properties": {
        "claim_id": { "type": "string", "pattern": "^claim-" },
        "scenario_id": { "type": "string", "pattern": "^SCN-[0-9]{2}$" },
        "claim_version": { "type": "integer", "minimum": 1 },
        "previous_claim_version": { "type": ["integer", "null"], "minimum": 1 },
        "claim_text": { "type": "string", "minLength": 5 },
        "claim_atom_ids": {
          "type": "array",
          "items": { "type": "string", "pattern": "^atom-" }
        },
        "user_edited": { "type": "boolean" },
        "reverification_state_on_new_version": {
          "type": "string",
          "enum": [
            "NOT_APPLICABLE_UNEDITED",
            "REVERIFY_REQUIRED_ON_NEW_VERSION",
            "REVERIFIED_FAILED_ON_NEW_VERSION",
            "REVERIFIED_PASSED_ON_NEW_VERSION"
          ]
        },
        "user_edit_history": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["event_id", "from_version", "to_version", "action", "severity", "note"],
            "additionalProperties": false,
            "properties": {
              "event_id": { "type": "string" },
              "from_version": { "type": "integer", "minimum": 1 },
              "to_version": { "type": "integer", "minimum": 1 },
              "action": {
                "type": "string",
                "enum": [
                  "EDIT_CLAIM_TEXT",
                  "EDIT_ATOM_TEXT",
                  "DELETE_SOURCE",
                  "DELETE_SOURCE_PREVIEW_CONFIRMED",
                  "BLOCK_DEPENDENT_CLAIM_ACCESS",
                  "PURGE_DEPENDENT_CLAIM_AND_SERVER_COPIES",
                  "DELETE_FACT",
                  "REMOVE_SUPPORT"
                ]
              },
              "severity": { "type": "string", "enum": ["MINOR_PARAPHRASE", "SUBSTANTIVE", "CASCADE_DELETE"] },
              "note": { "type": "string" }
            }
          }
        },
        "deletion_lifecycle": {
          "type": ["object", "null"],
          "required": [
            "policy_ref",
            "trigger_source_revision_id",
            "deletion_preview_shown",
            "explicit_user_confirmation",
            "immediate_access_blocked_after_confirmation",
            "cleanup_completed",
            "pre_deletion_server_artifacts",
            "post_cleanup_retained_claim_versions",
            "post_cleanup_retained_edited_copies",
            "post_cleanup_retained_approved_copies",
            "independent_source_revisions_preserved",
            "independent_facts_preserved",
            "distinguished_from_refetch_failure_ref03"
          ],
          "additionalProperties": false,
          "properties": {
            "policy_ref": { "type": "string", "const": "OD-003" },
            "trigger_source_revision_id": { "type": "string", "pattern": "^rev-" },
            "deletion_preview_shown": { "type": "boolean" },
            "explicit_user_confirmation": { "type": "boolean" },
            "immediate_access_blocked_after_confirmation": { "type": "boolean" },
            "cleanup_completed": { "type": "boolean" },
            "pre_deletion_server_artifacts": {
              "type": "object",
              "required": ["claim_versions", "has_server_edited_copy", "has_server_approved_copy"],
              "additionalProperties": false,
              "properties": {
                "claim_versions": { "type": "array", "items": { "type": "integer", "minimum": 1 } },
                "has_server_edited_copy": { "type": "boolean" },
                "has_server_approved_copy": { "type": "boolean" }
              }
            },
            "post_cleanup_retained_claim_versions": {
              "type": "array",
              "items": { "type": "integer", "minimum": 1 }
            },
            "post_cleanup_retained_edited_copies": { "type": "integer", "minimum": 0 },
            "post_cleanup_retained_approved_copies": { "type": "integer", "minimum": 0 },
            "independent_source_revisions_preserved": {
              "type": "array",
              "items": { "type": "string", "pattern": "^rev-" }
            },
            "independent_facts_preserved": {
              "type": "array",
              "items": { "type": "string", "pattern": "^fact-" }
            },
            "distinguished_from_refetch_failure_ref03": { "type": "boolean" }
          }
        },
        "derived_from_claim_ids": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "Stage3ClaimAssemblyFile": {
      "type": "object",
      "required": [
        "schema_version",
        "dataset_version",
        "stage_name",
        "stage_responsibility",
        "artifact_role",
        "claims",
        "claim_atoms",
        "claim_atom_supports"
      ],
      "additionalProperties": false,
      "properties": {
        "schema_version": { "type": "string", "const": "0.3.0-synthetic-golden" },
        "dataset_version": { "type": "string", "const": "0.3.0-synthetic-golden" },
        "stage_name": { "type": "string", "const": "STAGE_3_CLAIM_ASSEMBLY" },
        "stage_responsibility": { "type": "string", "minLength": 10 },
        "artifact_role": { "type": "string", "const": "STAGE_STUB_OUTPUT" },
        "claims": {
          "type": "array",
          "items": { "$ref": "#/$defs/Claim" }
        },
        "claim_atoms": {
          "type": "array",
          "items": { "$ref": "#/$defs/ClaimAtom" }
        },
        "claim_atom_supports": {
          "type": "array",
          "items": { "$ref": "#/$defs/ClaimAtomSupport" }
        }
      }
    },
    "RefetchSnapshot": {
      "type": "object",
      "required": [
        "fixture_case_id",
        "official_ref_id",
        "legacy_draft_id",
        "scenario_title",
        "target_url",
        "url_safety_precheck",
        "fetch_attempted",
        "http_status",
        "stub_error_code",
        "is_partial_response",
        "returned_content_sha256",
        "returned_body_fixture_only",
        "canary_tokens"
      ],
      "additionalProperties": false,
      "properties": {
        "fixture_case_id": { "type": "string", "pattern": "^refcase-0[1-8][a-z]$" },
        "official_ref_id": { "type": "string", "pattern": "^REF-0[1-8]$" },
        "legacy_draft_id": { "type": ["string", "null"], "pattern": "^REF-0[1-8]$" },
        "scenario_title": { "type": "string", "minLength": 5 },
        "target_url": { "type": "string", "minLength": 5 },
        "additional_unsafe_urls": {
          "type": "array",
          "items": { "type": "string" }
        },
        "url_safety_precheck": { "type": "string", "enum": ["ALLOWED", "BLOCKED_UNSAFE_URL"] },
        "fetch_attempted": { "type": "boolean" },
        "http_status": { "type": ["integer", "null"] },
        "stub_error_code": { "type": ["string", "null"] },
        "is_partial_response": { "type": "boolean" },
        "returned_content_sha256": { "type": ["string", "null"] },
        "returned_body_fixture_only": { "type": ["string", "null"] },
        "canary_tokens": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "RefetchSnapshotsFile": {
      "type": "object",
      "required": [
        "schema_version",
        "dataset_version",
        "artifact_role",
        "refetch_snapshots"
      ],
      "additionalProperties": false,
      "properties": {
        "schema_version": { "type": "string", "const": "0.3.0-synthetic-golden" },
        "dataset_version": { "type": "string", "const": "0.3.0-synthetic-golden" },
        "artifact_role": { "type": "string", "const": "SYNTHETIC_REFETCH_STUB_INPUT" },
        "refetch_snapshots": {
          "type": "array",
          "items": { "$ref": "#/$defs/RefetchSnapshot" }
        }
      }
    },
    "RefetchCheckRecord": {
      "type": "object",
      "required": [
        "fixture_case_id",
        "official_ref_id",
        "legacy_draft_id",
        "baseline_source_revision_id",
        "baseline_locator",
        "target_claim_id",
        "stub_outcome",
        "locator_recheck_matched",
        "hash_recheck_matched",
        "persisted_payload_snapshot",
        "negative_leaky_payload_fixture",
        "post_mvp_tags"
      ],
      "additionalProperties": false,
      "properties": {
        "fixture_case_id": { "type": "string", "pattern": "^refcase-0[1-8][a-z]$" },
        "official_ref_id": { "type": "string", "pattern": "^REF-0[1-8]$" },
        "legacy_draft_id": { "type": ["string", "null"], "pattern": "^REF-0[1-8]$" },
        "baseline_source_revision_id": { "type": "string", "pattern": "^rev-" },
        "baseline_locator": { "$ref": "#/$defs/Locator" },
        "tested_locator": { "$ref": "#/$defs/Locator" },
        "target_claim_id": { "type": "string", "pattern": "^claim-" },
        "stub_outcome": {
          "type": "string",
          "enum": [
            "STUB_REFETCH_MATCHED",
            "STUB_HASH_LOCATOR_MISMATCH_BLOCKED",
            "STUB_HASH_MISMATCH_NEW_REVISION_NO_AUTO_MUTATION",
            "STUB_SAME_HASH_LOCATOR_ONLY_MISMATCH_BLOCKED",
            "STUB_SOURCE_UNAVAILABLE_404",
            "STUB_PARTIAL_TRUNCATED_206",
            "STUB_TRANSIENT_RATE_LIMIT_429_RETRY_EXHAUSTED",
            "STUB_TRANSIENT_SERVER_ERROR_5XX_RETRY_EXHAUSTED",
            "STUB_TRANSIENT_TIMEOUT_RETRY_EXHAUSTED",
            "STUB_CANARY_STATIC_SNAPSHOT_CLEAN",
            "STUB_POLICY_PERMISSION_DENIED_403",
            "STUB_UNSAFE_URL_BLOCKED_PREFETCH"
          ]
        },
        "locator_recheck_matched": { "type": ["boolean", "null"] },
        "hash_recheck_matched": { "type": ["boolean", "null"] },
        "retry_policy_stub": {
          "type": ["object", "null"],
          "required": [
            "transient_failure_class",
            "max_retry_attempts",
            "attempts_exhausted_in_stub",
            "approval_blocked_while_unavailable",
            "distinguished_from_404"
          ],
          "additionalProperties": false,
          "properties": {

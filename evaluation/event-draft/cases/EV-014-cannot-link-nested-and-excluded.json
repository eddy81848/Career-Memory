  "rationale": {
    "summary": "Enforces official Event API rejection codes with zero mutation while matching every merge target's expected_version to its actual current version (version 2 across expected_version, target_versions, and payload.members) so no EVENT_VERSION_CONFLICT intrudes: nesting a USER_COMPOSITE root returns NESTED_COMPOSITE_NOT_ALLOWED; merging a REJECTED Event returns MEMBER_NOT_ACTIVE; re-merging an already-composed SUPERSEDED member is rejected with zero mutation while leaving precedence between MEMBER_ALREADY_COMPOSED and MEMBER_NOT_ACTIVE UNCONFIRMED. Does NOT bundle all rejections into a catch-all CANNOT_LINK wire code and does NOT invent an append API.",
    "confirmed_spec_rules": [
      "USER_COMPOSITE_NESTING_FORBIDDEN_WITH_NESTED_COMPOSITE_NOT_ALLOWED",
      "REJECTED_EVENT_MERGE_FORBIDDEN_WITH_MEMBER_NOT_ACTIVE",
      "SUBSUMED_COMPOSITE_MEMBERS_ARE_SUPERSEDED",
      "CANNOT_LINK_IS_RELATION_SEMANTIC_NOT_CATCH_ALL_WIRE_CODE",
      "REJECTED_COMMAND_CAUSES_ZERO_MUTATION"
    ],
    "unconfirmed_spec_tokens": [
      "spec_command_name and HTTP status codes for NESTED_COMPOSITE_NOT_ALLOWED / MEMBER_NOT_ACTIVE / MEMBER_ALREADY_COMPOSED (left UNCONFIRMED)"
    ],
    "truly_undecided_items": [
      "Multi-violation error precedence when a member is simultaneously already composed (MEMBER_ALREADY_COMPOSED) and SUPERSEDED (MEMBER_NOT_ACTIVE)."
    ]
  }

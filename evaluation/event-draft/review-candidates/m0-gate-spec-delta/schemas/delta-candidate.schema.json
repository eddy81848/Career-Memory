{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://career-memory.example.invalid/schemas/event-draft-delta-candidate.v1.json",
  "title": "Career Memory M0-GATE Spec-Delta Review Candidate Schema (Isolated Draft)",
  "description": "Isolated draft schema for M0-GATE spec-delta review candidates under evaluation/event-draft/review-candidates/m0-gate-spec-delta/. Extends event-draft-case.v1 ONLY where confirmed spec gaps cannot be expressed in case.schema.json without inventing unapproved wire fields. Does NOT alter schemas/case.schema.json or 1.0.0-mvp-approved.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "candidate_id",
    "candidate_kind",
    "target_case_id",
    "baseline_case_ref",
    "slug",
    "title",
    "scope",
    "backlog_ref",
    "post_mvp_reason",
    "review_status",
    "eval_grouping",
    "spec_delta_trace",
    "schema_gaps_required",
    "coverage",
    "synthetic_sources",
    "user_commands",
    "expected_proposal",
    "rationale"
  ],
  "properties": {
    "schema_version": {
      "const": "event-draft-delta-candidate.v1"
    },
    "candidate_id": {
      "type": "string",
      "pattern": "^(DELTA-EV-[0-9]{3}|CAND-EV-[0-9]{3})$"
    },
    "candidate_kind": {
      "type": "string",
      "enum": ["AMENDMENT_CANDIDATE", "NEW_CASE_CANDIDATE"]
    },
    "target_case_id": {
      "type": "string",
      "pattern": "^EV-[0-9]{3}$"
    },
    "baseline_case_ref": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["baseline_commit_sha", "baseline_dataset_version", "baseline_path", "baseline_file_sha256", "before_after_summary"],
      "properties": {
        "baseline_commit_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "baseline_dataset_version": { "type": "string", "minLength": 1 },
        "baseline_path": { "type": "string", "minLength": 1 },
        "baseline_file_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "before_after_summary": {
          "type": "object",
          "additionalProperties": false,
          "required": ["before", "after", "unchanged_guarantees"],
          "properties": {
            "before": { "type": "string", "minLength": 1 },
            "after": { "type": "string", "minLength": 1 },
            "unchanged_guarantees": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 },
              "minItems": 1
            }
          }
        }
      }
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "string",
      "enum": ["MVP"]
    },
    "backlog_ref": {
      "type": "null"
    },
    "post_mvp_reason": {
      "type": "null"
    },
    "review_status": {
      "const": "REVIEW_REQUIRED"
    },
    "eval_grouping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eval_bundle_id", "source_lineage_group", "eval_partition", "derived_from_same_source_cases"],
      "properties": {
        "eval_bundle_id": { "type": "string", "minLength": 1 },
        "source_lineage_group": { "type": "string", "minLength": 1 },
        "eval_partition": { "const": "MVP_REVIEW_CANDIDATE_DRAFT" },
        "derived_from_same_source_cases": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1
        }
      }
    },
    "spec_delta_trace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gap_id",
        "notion_clauses",
        "existing_gap",
        "synthetic_input_summary",
        "expected_behavior_summary",
        "verification_tests"
      ],
      "properties": {
        "gap_id": {
          "type": "string",
          "enum": ["GAP-1-EV002-CONFIRM-HINT", "GAP-2-DEFAULT-BRANCH-PR-DEDUP", "GAP-3-ACTIVE-CANNOT-LINK", "GAP-4-KEEP-EDIT-TRACKING"]
        },
        "notion_clauses": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1
        },
        "existing_gap": { "type": "string", "minLength": 1 },
        "synthetic_input_summary": { "type": "string", "minLength": 1 },
        "expected_behavior_summary": { "type": "string", "minLength": 1 },
        "verification_tests": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1
        }
      }
    },
    "schema_gaps_required": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["gap_code", "base_schema_path", "limitation", "candidate_representation", "wire_field_frozen"],
        "properties": {
          "gap_code": { "type": "string", "minLength": 1 },
          "base_schema_path": { "type": "string", "minLength": 1 },
          "limitation": { "type": "string", "minLength": 1 },
          "candidate_representation": { "type": "string", "minLength": 1 },
          "wire_field_frozen": { "const": false }
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "draft_requirement_ids",
        "draft_test_ids",
        "official_requirement_refs",
        "official_test_refs",
        "scenario_tags"
      ],
      "properties": {
        "draft_requirement_ids": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1
        },
        "draft_test_ids": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1
        },
        "official_requirement_refs": {
          "type": "array",
          "items": { "type": "string", "enum": ["FR-006", "FR-007"] },
          "minItems": 1
        },
        "official_test_refs": {
          "type": "array",
          "items": { "type": "string", "enum": ["EVENT-10", "EVENT-11", "EVENT-12"] }
        },
        "scenario_tags": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1
        }
      }
    },
    "synthetic_sources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workspaces",
        "repositories",
        "sync_runs",
        "pull_requests",
        "commits",
        "issues_tickets",
        "initial_events",
        "event_relations",
        "post_sync_observations"
      ],
      "properties": {
        "workspaces": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["workspace_id", "name", "synthetic"],
            "properties": {
              "workspace_id": { "type": "string", "pattern": "^ws_syn_[a-z0-9_]+$" },
              "name": { "type": "string", "minLength": 1 },
              "synthetic": { "const": true }
            }
          }
        },
        "repositories": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["repo_id", "workspace_id", "full_name", "default_branch", "synthetic"],
            "properties": {
              "repo_id": { "type": "string", "pattern": "^repo_syn_[a-z0-9_]+$" },
              "workspace_id": { "type": "string" },
              "full_name": { "type": "string", "pattern": "^acme-syn-[a-z0-9-]+/[a-z0-9-]+$" },
              "default_branch": { "type": "string", "minLength": 1 },
              "default_branch_reported_by_provider": { "type": "boolean" },
              "synthetic": { "const": true }
            }
          }
        },
        "sync_runs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "sync_run_id",
              "workspace_id",
              "repo_id",
              "run_type",
              "status",
              "promotes_events",
              "completed_at"
            ],
            "properties": {
              "sync_run_id": { "type": "string", "pattern": "^sync_syn_[a-z0-9_]+$" },
              "workspace_id": { "type": "string" },
              "repo_id": { "type": "string" },
              "run_type": { "type": "string", "enum": ["INITIAL_BACKFILL"] },
              "status": { "type": "string", "enum": ["SUCCESS", "PARTIAL"] },
              "promotes_events": { "type": "boolean" },
              "completed_at": { "type": ["string", "null"] },
              "import_window_start": { "type": "string" },
              "import_window_end": { "type": "string" },
              "note": { "type": "string" }
            }
          }
        },
        "pull_requests": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "pr_id",
              "repo_id",
              "number",
              "title",
              "body",
              "author_handle",
              "head_branch",
              "base_branch",
              "state",
              "merged_at",
              "commit_ids",
              "referenced_ticket_ids"
            ],
            "properties": {
              "pr_id": { "type": "string", "pattern": "^pr_syn_[a-z0-9_]+$" },
              "repo_id": { "type": "string" },
              "number": { "type": "integer", "minimum": 1 },
              "title": { "type": "string", "minLength": 1 },
              "body": { "type": "string" },
              "author_handle": { "type": "string", "pattern": "^syn-[a-z0-9-]+$" },
              "head_branch": { "type": "string", "minLength": 1 },
              "base_branch": { "type": "string", "minLength": 1 },
              "state": { "type": "string", "enum": ["MERGED", "OPEN", "CLOSED_UNMERGED"] },
              "merged_at": { "type": ["string", "null"] },
              "merge_strategy": { "type": "string", "enum": ["MERGE_COMMIT", "SQUASH", "REBASE"] },
              "within_import_window": { "type": "boolean" },
              "commit_ids": { "type": "array", "items": { "type": "string" } },
              "referenced_ticket_ids": { "type": "array", "items": { "type": "string" } },
              "source_sync_run_id": { "type": "string" }
            }
          }
        },
        "out_of_window_pr_associations": {
          "type": "array",
          "description": "Fixture input premise: provider commit-to-PR association observed during import that resolves an in-window default-branch commit to a PR outside the import window. Explicitly separated from in-window pull_requests and merge-time PR member commits; does NOT assert live GitHub lookup behavior.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "association_observation_id",
              "repo_id",
              "source_sync_run_id",
              "observed_default_branch_commit_id",
              "external_pr_id",
              "pr_number",
              "pr_title",
              "base_branch",
              "state",
              "merge_strategy",
              "pr_merged_at",
              "within_import_window",
              "merge_time_head_commit_sha",
              "provider_association_is_fixture_input_premise",
              "premise_note"
            ],
            "properties": {
              "association_observation_id": { "type": "string", "pattern": "^obs_pr_assoc_syn_[a-z0-9_]+$" },
              "repo_id": { "type": "string" },
              "source_sync_run_id": { "type": "string" },
              "observed_default_branch_commit_id": { "type": "string", "pattern": "^cmt_syn_[a-z0-9_]+$" },
              "external_pr_id": { "type": "string", "pattern": "^pr_syn_[a-z0-9_]+$" },
              "pr_number": { "type": "integer", "minimum": 1 },
              "pr_title": { "type": "string", "minLength": 1 },
              "base_branch": { "type": "string", "minLength": 1 },
              "state": { "const": "MERGED" },
              "merge_strategy": { "type": "string", "enum": ["MERGE_COMMIT", "SQUASH", "REBASE"] },
              "pr_merged_at": { "type": "string", "minLength": 1 },
              "within_import_window": { "const": false },
              "merge_time_head_commit_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
              "provider_association_is_fixture_input_premise": { "const": true },
              "premise_note": { "type": "string", "minLength": 1 }
            }
          }
        },
        "commits": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "commit_id",
              "repo_id",
              "sha",
              "message",
              "author_handle",
              "committed_at",
              "branch_name",
              "on_default_branch",
              "default_branch_verified_at_start_and_end",
              "pr_association_lookup_status",
              "pr_association_status",
              "associated_pr_id",
              "changed_paths"
            ],
            "properties": {
              "commit_id": { "type": "string", "pattern": "^cmt_syn_[a-z0-9_]+$" },
              "repo_id": { "type": "string" },
              "sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
              "message": { "type": "string", "minLength": 1 },
              "author_handle": { "type": "string", "pattern": "^syn-[a-z0-9-]+$" },
              "committed_at": { "type": "string" },
              "within_import_window": { "type": "boolean" },
              "branch_name": { "type": "string", "minLength": 1 },
              "on_default_branch": { "type": "boolean" },
              "default_branch_verified_at_start_and_end": { "type": "boolean" },
              "pr_association_lookup_status": { "type": "string", "enum": ["COMPLETED", "INCOMPLETE_OR_FAILED"] },
              "pr_association_status": { "type": "string", "enum": ["ASSOCIATED", "NO_MATCH_OBSERVED", "UNKNOWN"] },
              "associated_pr_id": { "type": ["string", "null"] },
              "heuristic_similarity_decoy_for_pr_id": { "type": ["string", "null"] },
              "changed_paths": { "type": "array", "items": { "type": "string" } },
              "source_sync_run_id": { "type": "string" }
            }
          }
        },
        "issues_tickets": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["ticket_id", "repo_id", "external_key", "title", "relation_role"],
            "properties": {
              "ticket_id": { "type": "string", "pattern": "^tkt_syn_[a-z0-9_]+$" },
              "repo_id": { "type": "string" },
              "external_key": { "type": "string", "pattern": "^SYN-[0-9]+$" },
              "title": { "type": "string", "minLength": 1 },
              "relation_role": { "const": "CONTEXT_ONLY" }
            }
          }
        },
        "initial_events": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "event_id",
              "workspace_id",
              "repo_id",
              "anchor_mode",
              "lifecycle_status",
              "is_active_top_level",
              "version",
              "merge_origin",
              "primary_pr_id",
              "source_commit_ids",
              "context_ticket_ids",
              "member_event_ids",
              "dependent_artifacts",
              "membership_role",
              "searchable_as_top_level",
              "counted_in_metrics"
            ],
            "properties": {
              "event_id": { "type": "string", "pattern": "^ev_init_[a-z0-9_]+$" },
              "workspace_id": { "type": "string" },
              "repo_id": { "type": "string" },
              "anchor_mode": { "type": "string", "enum": ["PR", "PR_SEGMENT", "DIRECT_COMMIT", "USER_COMPOSITE"] },
              "lifecycle_status": { "type": "string", "enum": ["CANDIDATE", "CONFIRMED", "REJECTED", "SUPERSEDED", "STALE"] },
              "is_active_top_level": { "type": "boolean" },
              "version": { "type": "integer", "minimum": 1 },
              "merge_origin": { "type": "string", "enum": ["NONE", "USER_MANUAL_MERGE"] },
              "primary_pr_id": { "type": ["string", "null"] },
              "source_commit_ids": { "type": "array", "items": { "type": "string" } },
              "context_ticket_ids": { "type": "array", "items": { "type": "string" } },
              "member_event_ids": { "type": "array", "items": { "type": "string" } },
              "dependent_artifacts": {
                "type": "object",
                "additionalProperties": false,
                "required": ["fact_ids", "claim_ids", "export_ids"],
                "properties": {
                  "fact_ids": { "type": "array", "items": { "type": "string", "pattern": "^fct_syn_[a-z0-9_]+$" } },
                  "claim_ids": { "type": "array", "items": { "type": "string", "pattern": "^clm_syn_[a-z0-9_]+$" } },
                  "export_ids": { "type": "array", "items": { "type": "string", "pattern": "^exp_syn_[a-z0-9_]+$" } }
                }
              },
              "membership_role": { "type": "string", "enum": ["standalone", "user_composite_root", "subsumed_by_user_composite", "split_parent", "split_child"] },
              "composite_membership_status": { "type": ["string", "null"], "enum": [null, "ACTIVE", "REMOVED"] },
              "title": { "type": "string", "minLength": 1 },
              "summary": { "type": "string", "minLength": 1 },
              "source_sync_run_id": { "type": ["string", "null"] },
              "precondition_note": { "type": "string" },
              "searchable_as_top_level": { "type": "boolean" },
              "counted_in_metrics": { "type": "boolean" }
            }
          }
        },
        "event_relations": {
          "type": "array",
          "description": "Logical Event-to-Event relation fixtures (e.g., explicit CANNOT_LINK between active Events). Logical contract only; no OD-007 physical table assumed.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["relation_id", "workspace_id", "relation_type", "source_event_id", "target_event_id", "reason"],
            "properties": {
              "relation_id": { "type": "string", "pattern": "^rel_syn_[a-z0-9_]+$" },
              "workspace_id": { "type": "string" },
              "relation_type": { "const": "CANNOT_LINK" },
              "source_event_id": { "type": "string", "pattern": "^ev_init_[a-z0-9_]+$" },
              "target_event_id": { "type": "string", "pattern": "^ev_init_[a-z0-9_]+$" },
              "reason": { "type": "string", "minLength": 1 }
            }
          }
        },
        "post_sync_observations": {
          "type": "array",
          "maxItems": 0
        }
      }
    },
    "user_commands": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "command_id",
          "command_action",
          "spec_command_name",
          "workspace_id",
          "actor_id",
          "expected_version",
          "target_event_ids",
          "target_versions",
          "payload"
        ],
        "properties": {
          "command_id": { "type": "string", "pattern": "^cmd_syn_[a-z0-9_]+$" },
          "command_action": {
            "type": "string",
            "enum": ["split", "manual_merge", "exclude", "dissolve", "confirm", "edit"],
            "description": "Logical curation operation. UI label 'Keep' is NEVER invented as a separate API action."
          },
          "spec_command_name": {
            "type": "string",
            "enum": [
              "UNCONFIRMED",
              "POST /work-events/{id}/actions/confirm",
              "PATCH /work-events/{id}"
            ],
            "description": "Confirmed MVP API §5 routes for confirm and edit; other unconfirmed routes remain UNCONFIRMED."
          },
          "ui_label_distinction_note": { "type": "string", "minLength": 1 },
          "workspace_id": { "type": "string" },
          "actor_id": { "type": "string", "pattern": "^usr_syn_[a-z0-9_]+$" },
          "expected_version": { "type": "integer", "minimum": 1 },
          "idempotency_key": { "type": ["string", "null"] },
          "target_event_ids": {
            "type": "array",
            "items": { "type": "string" },
            "minItems": 1
          },
          "target_versions": {
            "type": "object",
            "additionalProperties": { "type": "integer", "minimum": 1 }
          },
          "payload": { "type": "object" }
        }
      }
    },
    "expected_proposal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "approval_status",
        "approved_by",
        "events",
        "held_items",
        "unpersisted_external_observations",
        "command_results",
        "review_actions",
        "downstream_side_effects",
        "search_checks",
        "aggregation_check",
        "review_required_items"
      ],
      "properties": {
        "approval_status": { "const": "DRAFT" },
        "approved_by": { "type": "null" },
        "events": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "event_id",
              "workspace_id",
              "repo_id",
              "anchor_mode",
              "lifecycle_status",
              "is_active_top_level",
              "version",
              "merge_origin",
              "origin_command_id",
              "primary_pr_id",
              "source_commit_ids",
              "context_ticket_ids",
              "member_event_ids",
              "parent_event_id",
              "membership_role",
              "searchable_as_top_level",
              "counted_in_metrics",
              "unconfirmed_fields"
            ],
            "properties": {
              "event_id": { "type": "string", "minLength": 1 },
              "workspace_id": { "type": "string" },
              "repo_id": { "type": "string" },
              "anchor_mode": { "type": "string", "enum": ["PR", "PR_SEGMENT", "DIRECT_COMMIT", "USER_COMPOSITE"] },
              "lifecycle_status": { "type": "string", "enum": ["CANDIDATE", "CONFIRMED", "REJECTED", "SUPERSEDED", "STALE"] },
              "is_active_top_level": { "type": "boolean" },
              "version": { "type": "integer", "minimum": 1 },
              "previous_version": { "type": ["integer", "null"], "minimum": 1 },
              "prior_version_preserved": { "type": "boolean" },
              "merge_origin": { "type": "string", "enum": ["NONE", "USER_MANUAL_MERGE"] },
              "origin_command_id": { "type": ["string", "null"] },
              "primary_pr_id": { "type": ["string", "null"] },
              "source_commit_ids": { "type": "array", "items": { "type": "string" } },
              "context_ticket_ids": { "type": "array", "items": { "type": "string" } },
              "member_event_ids": { "type": "array", "items": { "type": "string" } },
              "parent_event_id": { "type": ["string", "null"] },
              "membership_role": { "type": "string", "enum": ["standalone", "user_composite_root", "subsumed_by_user_composite", "split_parent", "split_child"] },
              "composite_membership_status": { "type": ["string", "null"], "enum": [null, "ACTIVE", "REMOVED"] },
              "direct_commit_confirmation_expectation": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "requires_user_association_confirmation",
                  "no_match_observed_means_definitely_no_pr",
                  "spec_api_field_name",
                  "spec_badge_text",
                  "semantic_note"
                ],
                "properties": {
                  "requires_user_association_confirmation": { "const": true },
                  "no_match_observed_means_definitely_no_pr": { "const": false },
                  "spec_api_field_name": { "const": "UNCONFIRMED" },
                  "spec_badge_text": { "const": "UNCONFIRMED" },
                  "semantic_note": { "type": "string", "minLength": 1 }
                }
              },
              "dependent_artifacts_unchanged": {
                "type": "object",
                "additionalProperties": false,
                "required": ["fact_ids", "claim_ids", "export_ids"],
                "properties": {
                  "fact_ids": { "type": "array", "items": { "type": "string" } },
                  "claim_ids": { "type": "array", "items": { "type": "string" } },
                  "export_ids": { "type": "array", "items": { "type": "string" } }
                }
              },
              "title": { "type": "string", "minLength": 1 },
              "summary": { "type": "string", "minLength": 1 },
              "title_hint": { "type": "string" },
              "searchable_as_top_level": { "type": "boolean" },
              "counted_in_metrics": { "type": "boolean" },
              "unconfirmed_fields": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "held_items": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "held_id",
              "record_kind",
              "source_type",
              "source_id",
              "logical_disposition",
              "spec_hold_status",
              "hold_reason",
              "interpreted_as_no_pr",
              "unconfirmed_fields"
            ],
            "properties": {
              "held_id": { "type": "string", "minLength": 1 },
              "record_kind": { "type": "string", "enum": ["OBSERVATION_RECORD", "NON_ELIGIBLE_SOURCE_RECORD"] },
              "source_type": { "type": "string", "enum": ["COMMIT", "PR"] },
              "source_id": { "type": "string", "minLength": 1 },
              "logical_disposition": {
                "type": "string",
                "enum": [
                  "hold_classification_unknown_assoc",
                  "not_direct_commit_candidate_non_default_branch"
                ]
              },
              "spec_hold_status": { "const": "UNCONFIRMED" },
              "hold_reason": { "type": "string", "minLength": 1 },
              "interpreted_as_no_pr": { "const": false },
              "unconfirmed_fields": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "out_of_window_pr_dedup_checks": {
          "type": "array",
          "description": "Semantic non-duplication assertions for commits whose provider lookup resolved an out-of-window PR. Does NOT prescribe an internal diagnostic record persistence format.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "association_observation_id",
              "commit_id",
              "external_pr_id",
              "creates_new_pr_event",
              "creates_direct_commit_event",
              "diagnostic_persistence_format",
              "reason"
            ],
            "properties": {
              "association_observation_id": { "type": "string", "pattern": "^obs_pr_assoc_syn_[a-z0-9_]+$" },
              "commit_id": { "type": "string", "pattern": "^cmt_syn_[a-z0-9_]+$" },
              "external_pr_id": { "type": "string", "pattern": "^pr_syn_[a-z0-9_]+$" },
              "creates_new_pr_event": { "const": false },
              "creates_direct_commit_event": { "const": false },
              "diagnostic_persistence_format": { "const": "UNCONFIRMED" },
              "reason": { "type": "string", "minLength": 1 }
            }
          }
        },
        "unpersisted_external_observations": {
          "type": "array",
          "maxItems": 0
        },
        "command_results": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "command_id",
              "outcome",
              "rejection_category",
              "spec_error_code",
              "state_mutated",
              "resulting_event_ids",
              "unconfirmed_fields"
            ],
            "properties": {
              "command_id": { "type": "string", "minLength": 1 },
              "outcome": { "type": "string", "enum": ["ACCEPTED", "REJECTED"] },
              "rejection_category": {
                "type": ["string", "null"],
                "enum": [null, "cannot_link_conflict"]
              },
              "spec_error_code": {
                "type": ["string", "null"],
                "enum": [null, "CANNOT_LINK_CONFLICT"]
              },
              "state_mutated": { "type": "boolean" },
              "resulting_event_ids": { "type": "array", "items": { "type": "string" } },
              "unconfirmed_fields": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "review_actions": {
          "type": "array",
          "description": "Domain ReviewAction records (DB Model: CONFIRM / EDIT) produced by accepted confirm and edit operations, strictly separated from unconfirmed external API response tokens.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "review_action_id",
              "command_id",
              "event_id",
              "actor_id",
              "logical_action",
              "domain_review_action",
              "external_response_action_token",
              "from_version",
              "to_version",
              "changed_fields",
              "creates_new_event_version",
              "is_event_merge",
              "ui_label_distinction_note",
              "unconfirmed_fields"
            ],
            "properties": {
              "review_action_id": { "type": "string", "pattern": "^rev_exp_[a-z0-9_]+$" },
              "command_id": { "type": "string", "minLength": 1 },
              "event_id": { "type": "string", "minLength": 1 },
              "actor_id": { "type": "string", "pattern": "^usr_syn_[a-z0-9_]+$" },
              "logical_action": { "type": "string", "enum": ["confirm", "edit"] },
              "domain_review_action": {
                "type": "string",
                "enum": ["CONFIRM", "EDIT"],
                "description": "Domain ReviewAction enum defined in DB Model (distinct from unconfirmed external API response token)."
              },
              "external_response_action_token": { "const": "UNCONFIRMED" },
              "from_version": { "type": "integer", "minimum": 1 },
              "to_version": { "type": "integer", "minimum": 2 },
              "changed_fields": {
                "type": "array",
                "items": { "type": "string", "minLength": 1 },
                "minItems": 1
              },
              "creates_new_event_version": { "const": true },
              "is_event_merge": { "const": false },
              "ui_label_distinction_note": { "type": "string", "minLength": 1 },
              "unconfirmed_fields": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "downstream_side_effects": {
          "type": "array",
          "maxItems": 0
        },
        "search_checks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["query", "expected_event_ids", "expected_result_count"],
            "properties": {
              "query": { "type": "string" },
              "workspace_id": { "type": "string" },
              "expected_event_ids": { "type": "array", "items": { "type": "string" } },
              "expected_result_count": { "type": "integer", "minimum": 0 }
            }
          }
        },
        "aggregation_check": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "total_countable_events",
            "total_user_composite_events",
            "total_held_items",
            "total_rejected_events"
          ],
          "properties": {
            "total_countable_events": { "type": "integer", "minimum": 0 },
            "total_user_composite_events": { "type": "integer", "minimum": 0 },
            "total_held_items": { "type": "integer", "minimum": 0 },
            "total_rejected_events": { "type": "integer", "minimum": 0 },
            "promoted_events_from_partial_runs": { "type": "integer", "const": 0 },
            "total_direct_commit_events": { "type": "integer", "minimum": 0 }
          }
        },
        "post_mvp_transition_note": { "type": "null" },
        "review_required_items": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["field_path", "category", "status", "question"],
            "properties": {
              "field_path": { "type": "string", "minLength": 1 },
              "category": { "type": "string", "enum": ["UNCONFIRMED_SPEC_TOKEN", "TRULY_UNDECIDED_BEHAVIOR", "SCHEMA_EXTENSION_REVIEW"] },
              "status": { "const": "REVIEW_REQUIRED" },
              "question": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "rationale": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "confirmed_spec_rules", "unconfirmed_spec_tokens", "truly_undecided_items"],
      "properties": {
        "summary": { "type": "string", "minLength": 1 },
        "confirmed_spec_rules": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 },
        "unconfirmed_spec_tokens": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "truly_undecided_items": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://career-memory.example.invalid/schemas/event-draft-case.v1.json",
  "title": "Career Memory T-001A Event Synthetic Fixture Case",
  "description": "Strict separation of synthetic_sources, user_commands, expected_proposal (DRAFT), and rationale. Separates spec-confirmed rules/tokens from UNCONFIRMED status/error names and truly undecided questions. Avoids OD-007 physical table assumptions.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case_id",
    "slug",
    "title",
    "scope",
    "backlog_ref",
    "post_mvp_reason",
    "review_status",
    "coverage",
    "synthetic_sources",
    "user_commands",
    "expected_proposal",
    "rationale"
  ],
  "properties": {
    "schema_version": {
      "const": "event-draft-case.v1"
    },
    "case_id": {
      "type": "string",
      "pattern": "^(EV|NEG)-[0-9]{3}$"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "string",
      "enum": ["MVP", "POST_MVP"]
    },
    "backlog_ref": {
      "type": ["string", "null"]
    },
    "post_mvp_reason": {
      "type": ["string", "null"]
    },
    "review_status": {
      "type": "string",
      "enum": ["PENDING_HUMAN_REVIEW", "REVIEW_REQUIRED"]
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requirement_ids", "test_ids", "scenario_tags"],
      "properties": {
        "requirement_ids": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1
        },
        "test_ids": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1
        },
        "scenario_tags": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1
        }
      }
    },
    "synthetic_sources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workspaces",
        "repositories",
        "sync_runs",
        "pull_requests",
        "commits",
        "issues_tickets",
        "initial_events",
        "post_sync_observations"
      ],
      "properties": {
        "workspaces": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["workspace_id", "name", "synthetic"],
            "properties": {
              "workspace_id": { "type": "string", "pattern": "^ws_syn_[a-z0-9_]+$" },
              "name": { "type": "string", "minLength": 1 },
              "synthetic": { "const": true }
            }
          }
        },
        "repositories": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["repo_id", "workspace_id", "full_name", "default_branch", "synthetic"],
            "properties": {
              "repo_id": { "type": "string", "pattern": "^repo_syn_[a-z0-9_]+$" },
              "workspace_id": { "type": "string" },
              "full_name": { "type": "string", "pattern": "^acme-syn-[a-z0-9-]+/[a-z0-9-]+$" },
              "default_branch": { "type": "string", "minLength": 1 },
              "synthetic": { "const": true }
            }
          }
        },
        "sync_runs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["sync_run_id", "workspace_id", "repo_id", "run_type", "status", "completed_at"],
            "properties": {
              "sync_run_id": { "type": "string", "pattern": "^sync_syn_[a-z0-9_]+$" },
              "workspace_id": { "type": "string" },
              "repo_id": { "type": "string" },
              "run_type": { "type": "string", "enum": ["INITIAL_BACKFILL", "POST_MVP_INCREMENTAL", "POST_MVP_ASSOC_REPAIR"] },
              "status": { "type": "string", "enum": ["SUCCESS", "PARTIAL_SUCCESS", "PENDING"] },
              "completed_at": { "type": ["string", "null"] }
            }
          }
        },
        "pull_requests": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "pr_id",
              "repo_id",
              "number",
              "title",
              "body",
              "author_handle",
              "head_branch",
              "base_branch",
              "state",
              "merged_at",
              "commit_ids",
              "referenced_ticket_ids"
            ],
            "properties": {
              "pr_id": { "type": "string", "pattern": "^pr_syn_[a-z0-9_]+$" },
              "repo_id": { "type": "string" },
              "number": { "type": "integer", "minimum": 1 },
              "title": { "type": "string", "minLength": 1 },
              "body": { "type": "string" },
              "author_handle": { "type": "string", "pattern": "^syn-[a-z0-9-]+$" },
              "head_branch": { "type": "string", "minLength": 1 },
              "base_branch": { "type": "string", "minLength": 1 },
              "state": { "type": "string", "enum": ["MERGED", "OPEN", "CLOSED_UNMERGED"] },
              "merged_at": { "type": ["string", "null"] },
              "commit_ids": { "type": "array", "items": { "type": "string" } },
              "referenced_ticket_ids": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "commits": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "commit_id",
              "repo_id",
              "sha",
              "message",
              "author_handle",
              "committed_at",
              "branch_name",
              "on_default_branch",
              "pr_association_lookup_status",
              "pr_association_status",
              "associated_pr_id",
              "changed_paths"
            ],
            "properties": {
              "commit_id": { "type": "string", "pattern": "^cmt_syn_[a-z0-9_]+$" },
              "repo_id": { "type": "string" },
              "sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
              "message": { "type": "string", "minLength": 1 },
              "author_handle": { "type": "string", "pattern": "^syn-[a-z0-9-]+$" },
              "committed_at": { "type": "string" },
              "branch_name": { "type": "string", "minLength": 1 },
              "on_default_branch": { "type": "boolean" },
              "pr_association_lookup_status": {
                "type": "string",
                "enum": ["COMPLETED", "INCOMPLETE_OR_FAILED"],
                "description": "Default-branch direct commit is only a candidate when lookup completed normally (COMPLETED) and observed NO_MATCH_OBSERVED."
              },
              "pr_association_status": {
                "type": "string",
                "enum": ["ASSOCIATED", "NO_MATCH_OBSERVED", "UNKNOWN"],
                "description": "NO_MATCH_OBSERVED and UNKNOWN are spec-confirmed tokens; ASSOCIATED denotes a matched PR in synthetic input."
              },
              "associated_pr_id": { "type": ["string", "null"] },
              "changed_paths": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "issues_tickets": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "ticket_id",
              "repo_id",
              "external_key",
              "title",
              "relation_role"
            ],
            "properties": {
              "ticket_id": { "type": "string", "pattern": "^tkt_syn_[a-z0-9_]+$" },
              "repo_id": { "type": "string" },
              "external_key": { "type": "string", "pattern": "^SYN-[0-9]+$" },
              "title": { "type": "string", "minLength": 1 },
              "relation_role": { "const": "CONTEXT_ONLY" }
            }
          }
        },
        "initial_events": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "event_id",
              "workspace_id",
              "repo_id",
              "logical_kind",
              "spec_event_type",
              "logical_state",
              "spec_lifecycle_status",
              "version",
              "merge_origin",
              "primary_pr_id",
              "source_commit_ids",
              "context_ticket_ids",
              "member_event_ids",
              "dependent_claim_ids",
              "membership_role",
              "searchable_as_top_level",
              "counted_in_metrics"
            ],
            "properties": {
              "event_id": { "type": "string", "pattern": "^ev_init_[a-z0-9_]+$" },
              "workspace_id": { "type": "string" },
              "repo_id": { "type": "string" },
              "logical_kind": {
                "type": "string",
                "enum": ["merged_pr_event", "direct_commit_event", "user_composite_event", "split_child_event"]
              },
              "spec_event_type": {
                "type": "string",
                "enum": ["USER_COMPOSITE", "UNCONFIRMED"]
              },
              "logical_state": {
                "type": "string",
                "enum": ["active", "excluded", "dissolved", "superseded"]
              },
              "spec_lifecycle_status": {
                "type": "string",
                "enum": ["UNCONFIRMED"]
              },
              "version": { "type": "integer", "minimum": 1 },
              "merge_origin": { "type": "string", "enum": ["NONE", "USER_MANUAL_MERGE"] },
              "primary_pr_id": { "type": ["string", "null"] },
              "source_commit_ids": { "type": "array", "items": { "type": "string" } },
              "context_ticket_ids": { "type": "array", "items": { "type": "string" } },
              "member_event_ids": { "type": "array", "items": { "type": "string" } },
              "dependent_claim_ids": {
                "type": "array",
                "items": { "type": "string", "pattern": "^clm_syn_[a-z0-9_]+$" }
              },
              "membership_role": {
                "type": "string",
                "enum": ["standalone", "user_composite_root", "subsumed_by_user_composite", "split_parent", "split_child"]
              },
              "searchable_as_top_level": { "type": "boolean" },
              "counted_in_metrics": { "type": "boolean" }
            }
          }
        },
        "post_sync_observations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["observation_id", "observation_type", "observed_at", "details"],
            "properties": {
              "observation_id": { "type": "string", "pattern": "^obs_syn_[a-z0-9_]+$" },
              "observation_type": {
                "type": "string",
                "enum": ["POST_SUCCESS_NEW_PR", "LATE_ASSOCIATION_RECOVERY"]
              },
              "observed_at": { "type": "string" },
              "details": { "type": "object" }
            }
          }
        }
      }
    },
    "user_commands": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "command_id",
          "command_action",
          "spec_command_name",
          "workspace_id",
          "actor_id",
          "expected_version",
          "target_event_ids",
          "target_versions",
          "payload"
        ],
        "properties": {
          "command_id": { "type": "string", "pattern": "^cmd_syn_[a-z0-9_]+$" },
          "command_action": {
            "type": "string",
            "enum": ["split", "manual_merge", "exclude", "dissolve"]
          },
          "spec_command_name": {
            "type": "string",
            "enum": ["UNCONFIRMED"]
          },
          "workspace_id": { "type": "string" },
          "actor_id": { "type": "string", "pattern": "^usr_syn_[a-z0-9_]+$" },
          "expected_version": { "type": "integer", "minimum": 1 },
          "target_event_ids": {
            "type": "array",
            "items": { "type": "string" },
            "minItems": 1
          },
          "target_versions": {
            "type": "object",
            "additionalProperties": { "type": "integer", "minimum": 1 }
          },
          "payload": { "type": "object" }
        }
      }
    },
    "expected_proposal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "approval_status",
        "approved_by",
        "events",
        "held_items",
        "command_results",
        "claim_side_effects",
        "search_checks",
        "aggregation_check",
        "review_required_items"
      ],
      "properties": {
        "approval_status": {
          "const": "DRAFT",
          "description": "Must stay DRAFT in T-001A; never frozen as golden by agent."
        },
        "approved_by": {
          "const": null
        },
        "events": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "event_id",
              "workspace_id",
              "repo_id",
              "logical_kind",
              "spec_event_type",
              "logical_state",
              "spec_lifecycle_status",
              "version",
              "merge_origin",
              "origin_command_id",
              "primary_pr_id",
              "source_commit_ids",
              "context_ticket_ids",
              "member_event_ids",
              "parent_event_id",
              "membership_role",
              "searchable_as_top_level",
              "counted_in_metrics",
              "unconfirmed_fields"
            ],
            "properties": {
              "event_id": { "type": "string", "minLength": 1 },
              "workspace_id": { "type": "string" },
              "repo_id": { "type": "string" },
              "logical_kind": {
                "type": "string",
                "enum": ["merged_pr_event", "direct_commit_event", "user_composite_event", "split_child_event"]
              },
              "spec_event_type": {
                "type": "string",
                "enum": ["USER_COMPOSITE", "UNCONFIRMED"]
              },
              "logical_state": {
                "type": "string",
                "enum": ["active", "excluded", "dissolved", "superseded"]
              },
              "spec_lifecycle_status": {
                "type": "string",
                "enum": ["UNCONFIRMED"]
              },
              "version": { "type": "integer", "minimum": 1 },
              "merge_origin": { "type": "string", "enum": ["NONE", "USER_MANUAL_MERGE"] },
              "origin_command_id": { "type": ["string", "null"] },
              "primary_pr_id": { "type": ["string", "null"] },
              "source_commit_ids": { "type": "array", "items": { "type": "string" } },
              "context_ticket_ids": { "type": "array", "items": { "type": "string" } },
              "member_event_ids": { "type": "array", "items": { "type": "string" } },
              "parent_event_id": { "type": ["string", "null"] },
              "membership_role": {
                "type": "string",
                "enum": ["standalone", "user_composite_root", "subsumed_by_user_composite", "split_parent", "split_child"]
              },
              "searchable_as_top_level": { "type": "boolean" },
              "counted_in_metrics": { "type": "boolean" },
              "title_hint": { "type": "string" },
              "unconfirmed_fields": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "held_items": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "held_id",
              "source_type",
              "source_id",
              "logical_disposition",
              "spec_hold_status",
              "hold_reason",
              "interpreted_as_no_pr",
              "unconfirmed_fields"
            ],
            "properties": {
              "held_id": { "type": "string", "minLength": 1 },
              "source_type": { "type": "string", "enum": ["COMMIT", "PR", "OBSERVATION"] },
              "source_id": { "type": "string", "minLength": 1 },
              "logical_disposition": {
                "type": "string",
                "enum": [
                  "hold_classification_unknown_assoc",
                  "not_direct_commit_candidate_non_default_branch",
                  "deferred_post_mvp"
                ]
              },
              "spec_hold_status": {
                "type": "string",
                "enum": ["UNCONFIRMED"]
              },
              "hold_reason": { "type": "string", "minLength": 1 },
              "interpreted_as_no_pr": { "const": false },
              "unconfirmed_fields": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "command_results": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "command_id",
              "outcome",
              "rejection_category",
              "spec_error_code",
              "state_mutated",
              "resulting_event_ids",
              "unconfirmed_fields"
            ],
            "properties": {
              "command_id": { "type": "string", "minLength": 1 },
              "outcome": { "type": "string", "enum": ["ACCEPTED", "REJECTED"] },
              "rejection_category": {
                "type": ["string", "null"],
                "enum": [
                  null,
                  "cannot_link_non_event_or_unknown",
                  "cannot_link_nested_user_composite",
                  "cannot_link_excluded_event",
                  "cannot_link_cross_repository",
                  "version_conflict",
                  "workspace_boundary_conflict"
                ]
              },
              "spec_error_code": {
                "type": ["string", "null"],
                "enum": [null, "CANNOT_LINK", "UNCONFIRMED"]
              },
              "state_mutated": { "type": "boolean" },
              "resulting_event_ids": { "type": "array", "items": { "type": "string" } },
              "unconfirmed_fields": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "claim_side_effects": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "claim_id",
              "source_composite_event_id",
              "expected_effect",
              "spec_claim_status",
              "reason"
            ],
            "properties": {
              "claim_id": { "type": "string", "pattern": "^clm_syn_[a-z0-9_]+$" },
              "source_composite_event_id": { "type": "string", "minLength": 1 },
              "expected_effect": { "const": "STALE" },
              "spec_claim_status": { "const": "UNCONFIRMED" },
              "reason": { "type": "string", "minLength": 1 }
            }
          }
        },
        "search_checks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["query", "expected_event_ids", "expected_result_count"],
            "properties": {
              "query": { "type": "string" },
              "expected_event_ids": { "type": "array", "items": { "type": "string" } },
              "expected_result_count": { "type": "integer", "minimum": 0 }
            }
          }
        },
        "aggregation_check": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "total_countable_events",
            "total_user_composite_events",
            "total_held_items",
            "total_excluded_events"
          ],
          "properties": {
            "total_countable_events": { "type": "integer", "minimum": 0 },
            "total_user_composite_events": { "type": "integer", "minimum": 0 },
            "total_held_items": { "type": "integer", "minimum": 0 },
            "total_excluded_events": { "type": "integer", "minimum": 0 }
          }
        },
        "post_mvp_transition_note": { "type": ["string", "null"] },
        "review_required_items": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["field_path", "category", "status", "question"],
            "properties": {
              "field_path": { "type": "string", "minLength": 1 },
              "category": {
                "type": "string",
                "enum": ["UNCONFIRMED_SPEC_TOKEN", "TRULY_UNDECIDED_BEHAVIOR"]
              },
              "status": { "const": "REVIEW_REQUIRED" },
              "question": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "rationale": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary",
        "confirmed_spec_rules",
        "unconfirmed_spec_tokens",
        "truly_undecided_items"
      ],
      "properties": {
        "summary": { "type": "string", "minLength": 1 },
        "confirmed_spec_rules": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1
        },
        "unconfirmed_spec_tokens": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "truly_undecided_items": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://career-memory.example.invalid/schemas/event-draft-case.v1.json",
  "title": "Career Memory T-001A Event Synthetic Fixture Case",
  "description": "Strict separation of synthetic_sources, user_commands, expected_proposal (DRAFT), and rationale. Aligns with official Event anchor modes, lifecycle statuses, Import Run statuses, and Event API error codes while leaving unverified wire details UNCONFIRMED. Avoids OD-007 physical table assumptions.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case_id",
    "slug",
    "title",
    "scope",
    "backlog_ref",
    "post_mvp_reason",
    "review_status",
    "coverage",
    "synthetic_sources",
    "user_commands",
    "expected_proposal",
    "rationale"
  ],
  "properties": {
    "schema_version": {
      "const": "event-draft-case.v1"
    },
    "case_id": {
      "type": "string",
      "pattern": "^(EV|NEG)-[0-9]{3}$"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "string",
      "enum": ["MVP", "POST_MVP"]
    },
    "backlog_ref": {
      "type": ["string", "null"]
    },
    "post_mvp_reason": {
      "type": ["string", "null"]
    },
    "review_status": {
      "type": "string",
      "enum": ["PENDING_HUMAN_REVIEW", "REVIEW_REQUIRED", "APPROVED_MVP_REGRESSION"]
    },
    "eval_grouping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eval_bundle_id", "source_lineage_group", "eval_partition", "derived_from_same_source_cases"],
      "properties": {
        "eval_bundle_id": { "type": "string", "minLength": 1 },
        "source_lineage_group": { "type": "string", "minLength": 1 },
        "eval_partition": {
          "type": "string",
          "enum": ["MVP_SYNTHETIC_REGRESSION", "POST_MVP_DRAFT_EXCLUDED"]
        },
        "derived_from_same_source_cases": {
          "type": "array",
          "items": { "type": "string", "pattern": "^EV-[0-9]{3}$" },
          "minItems": 1
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "draft_requirement_ids",
        "draft_test_ids",
        "official_requirement_refs",
        "official_test_refs",
        "scenario_tags"
      ],
      "properties": {
        "draft_requirement_ids": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1
        },
        "draft_test_ids": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1
        },
        "official_requirement_refs": {
          "type": "array",
          "items": { "type": "string", "enum": ["FR-006", "FR-007"] }
        },
        "official_test_refs": {
          "type": "array",
          "items": { "type": "string", "enum": ["EVENT-10", "EVENT-11", "EVENT-12"] }
        },
        "scenario_tags": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1
        }
      }
    },
    "synthetic_sources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workspaces",
        "repositories",
        "sync_runs",
        "pull_requests",
        "commits",
        "issues_tickets",
        "initial_events",
        "post_sync_observations"
      ],
      "properties": {
        "workspaces": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["workspace_id", "name", "synthetic"],
            "properties": {
              "workspace_id": { "type": "string", "pattern": "^ws_syn_[a-z0-9_]+$" },
              "name": { "type": "string", "minLength": 1 },
              "synthetic": { "const": true }
            }
          }
        },
        "repositories": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["repo_id", "workspace_id", "full_name", "default_branch", "synthetic"],
            "properties": {
              "repo_id": { "type": "string", "pattern": "^repo_syn_[a-z0-9_]+$" },
              "workspace_id": { "type": "string" },
              "full_name": { "type": "string", "pattern": "^acme-syn-[a-z0-9-]+/[a-z0-9-]+$" },
              "default_branch": { "type": "string", "minLength": 1 },
              "synthetic": { "const": true }
            }
          }
        },
        "sync_runs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "sync_run_id",
              "workspace_id",
              "repo_id",
              "run_type",
              "status",
              "promotes_events",
              "completed_at"
            ],
            "properties": {
              "sync_run_id": { "type": "string", "pattern": "^sync_syn_[a-z0-9_]+$" },
              "workspace_id": { "type": "string" },
              "repo_id": { "type": "string" },
              "run_type": { "type": "string", "enum": ["INITIAL_BACKFILL", "POST_MVP_INCREMENTAL", "POST_MVP_ASSOC_REPAIR"] },
              "status": {
                "type": "string",
                "enum": ["SUCCESS", "PARTIAL", "PENDING"],
                "description": "Official Snapshot Import Run statuses; PARTIAL_SUCCESS is NOT an official status and PARTIAL runs promote 0 Events."
              },
              "promotes_events": { "type": "boolean" },
              "completed_at": { "type": ["string", "null"] },
              "note": { "type": "string" }
            }
          }
        },
        "pull_requests": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "pr_id",
              "repo_id",
              "number",
              "title",
              "body",
              "author_handle",
              "head_branch",
              "base_branch",
              "state",
              "merged_at",
              "commit_ids",
              "referenced_ticket_ids"
            ],
            "properties": {
              "pr_id": { "type": "string", "pattern": "^pr_syn_[a-z0-9_]+$" },
              "repo_id": { "type": "string" },
              "number": { "type": "integer", "minimum": 1 },
              "title": { "type": "string", "minLength": 1 },
              "body": { "type": "string" },
              "author_handle": { "type": "string", "pattern": "^syn-[a-z0-9-]+$" },
              "head_branch": { "type": "string", "minLength": 1 },
              "base_branch": { "type": "string", "minLength": 1 },
              "state": { "type": "string", "enum": ["MERGED", "OPEN", "CLOSED_UNMERGED"] },
              "merged_at": { "type": ["string", "null"] },
              "commit_ids": { "type": "array", "items": { "type": "string" } },
              "referenced_ticket_ids": { "type": "array", "items": { "type": "string" } },
              "source_sync_run_id": { "type": "string" }
            }
          }
        },
        "commits": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "commit_id",
              "repo_id",
              "sha",
              "message",
              "author_handle",
              "committed_at",
              "branch_name",
              "on_default_branch",
              "default_branch_verified_at_start_and_end",
              "pr_association_lookup_status",
              "pr_association_status",
              "associated_pr_id",
              "changed_paths"
            ],
            "properties": {
              "commit_id": { "type": "string", "pattern": "^cmt_syn_[a-z0-9_]+$" },
              "repo_id": { "type": "string" },
              "sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
              "message": { "type": "string", "minLength": 1 },
              "author_handle": { "type": "string", "pattern": "^syn-[a-z0-9-]+$" },
              "committed_at": { "type": "string" },
              "branch_name": { "type": "string", "minLength": 1 },
              "on_default_branch": { "type": "boolean" },
              "default_branch_verified_at_start_and_end": {
                "type": "boolean",
                "description": "True when commit remained reachable on default branch at both start and end verification of a successful initial import."
              },
              "pr_association_lookup_status": {
                "type": "string",
                "enum": ["COMPLETED", "INCOMPLETE_OR_FAILED"]
              },
              "pr_association_status": {
                "type": "string",
                "enum": ["ASSOCIATED", "NO_MATCH_OBSERVED", "UNKNOWN"]
              },
              "associated_pr_id": { "type": ["string", "null"] },
              "changed_paths": { "type": "array", "items": { "type": "string" } },
              "source_sync_run_id": { "type": "string" }
            }
          }
        },
        "issues_tickets": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "ticket_id",
              "repo_id",
              "external_key",
              "title",
              "relation_role"
            ],
            "properties": {
              "ticket_id": { "type": "string", "pattern": "^tkt_syn_[a-z0-9_]+$" },
              "repo_id": { "type": "string" },
              "external_key": { "type": "string", "pattern": "^SYN-[0-9]+$" },
              "title": { "type": "string", "minLength": 1 },
              "relation_role": { "const": "CONTEXT_ONLY" }
            }
          }
        },
        "initial_events": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "event_id",
              "workspace_id",
              "repo_id",
              "anchor_mode",
              "lifecycle_status",
              "is_active_top_level",
              "version",
              "merge_origin",
              "primary_pr_id",
              "source_commit_ids",
              "context_ticket_ids",
              "member_event_ids",
              "dependent_artifacts",
              "membership_role",
              "searchable_as_top_level",
              "counted_in_metrics"
            ],
            "properties": {
              "event_id": { "type": "string", "pattern": "^ev_init_[a-z0-9_]+$" },
              "workspace_id": { "type": "string" },
              "repo_id": { "type": "string" },
              "anchor_mode": {
                "type": "string",
                "enum": ["PR", "PR_SEGMENT", "DIRECT_COMMIT", "USER_COMPOSITE"]
              },
              "lifecycle_status": {
                "type": "string",
                "enum": ["CANDIDATE", "CONFIRMED", "REJECTED", "SUPERSEDED", "STALE"]
              },
              "is_active_top_level": { "type": "boolean" },
              "version": { "type": "integer", "minimum": 1 },
              "merge_origin": { "type": "string", "enum": ["NONE", "USER_MANUAL_MERGE"] },
              "primary_pr_id": { "type": ["string", "null"] },
              "source_commit_ids": { "type": "array", "items": { "type": "string" } },
              "context_ticket_ids": { "type": "array", "items": { "type": "string" } },
              "member_event_ids": { "type": "array", "items": { "type": "string" } },
              "dependent_artifacts": {
                "type": "object",
                "additionalProperties": false,
                "required": ["fact_ids", "claim_ids", "export_ids"],
                "properties": {
                  "fact_ids": { "type": "array", "items": { "type": "string", "pattern": "^fct_syn_[a-z0-9_]+$" } },
                  "claim_ids": { "type": "array", "items": { "type": "string", "pattern": "^clm_syn_[a-z0-9_]+$" } },
                  "export_ids": { "type": "array", "items": { "type": "string", "pattern": "^exp_syn_[a-z0-9_]+$" } }
                }
              },
              "membership_role": {
                "type": "string",
                "enum": ["standalone", "user_composite_root", "subsumed_by_user_composite", "split_parent", "split_child"]
              },
              "composite_membership_status": { "type": ["string", "null"], "enum": [null, "ACTIVE", "REMOVED"] },
              "member_snapshots_preserved": { "type": "boolean" },
              "prior_review_status": { "type": ["string", "null"], "enum": [null, "CANDIDATE", "CONFIRMED", "STALE"] },
              "source_sync_run_id": { "type": ["string", "null"] },
              "precondition_note": { "type": "string" },
              "searchable_as_top_level": { "type": "boolean" },
              "counted_in_metrics": { "type": "boolean" }
            }
          }
        },
        "post_sync_observations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["observation_id", "observation_type", "observed_at", "details"],
            "properties": {
              "observation_id": { "type": "string", "pattern": "^obs_syn_[a-z0-9_]+$" },
              "observation_type": {
                "type": "string",
                "enum": ["POST_SUCCESS_NEW_PR", "LATE_ASSOCIATION_RECOVERY"]
              },
              "observed_at": { "type": "string" },
              "details": { "type": "object" }
            }
          }
        }
      }
    },
    "user_commands": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "command_id",
          "command_action",
          "spec_command_name",
          "workspace_id",
          "actor_id",
          "expected_version",
          "target_event_ids",
          "target_versions",
          "payload"
        ],
        "properties": {
          "command_id": { "type": "string", "pattern": "^cmd_syn_[a-z0-9_]+$" },
          "command_action": {
            "type": "string",
            "enum": ["split", "manual_merge", "exclude", "dissolve"]
          },
          "spec_command_name": {
            "type": "string",
            "enum": ["UNCONFIRMED"]
          },
          "workspace_id": { "type": "string" },
          "actor_id": { "type": "string", "pattern": "^usr_syn_[a-z0-9_]+$" },
          "expected_version": { "type": "integer", "minimum": 1 },
          "idempotency_key": { "type": ["string", "null"] },
          "target_event_ids": {
            "type": "array",
            "items": { "type": "string" },
            "minItems": 1
          },
          "target_versions": {
            "type": "object",
            "additionalProperties": { "type": "integer", "minimum": 1 }
          },
          "payload": { "type": "object" }
        }
      }
    },
    "expected_proposal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "approval_status",
        "approved_by",
        "events",
        "held_items",
        "unpersisted_external_observations",
        "command_results",
        "downstream_side_effects",
        "search_checks",
        "aggregation_check",
        "review_required_items"
      ],
      "properties": {
        "approval_status": {
          "type": "string",
          "enum": ["DRAFT", "APPROVED_MVP_REGRESSION"],
          "description": "DRAFT for unapproved Post-MVP drafts; APPROVED_MVP_REGRESSION only for human-approved MVP synthetic regression logical expectations."
        },
        "approved_by": {
          "type": ["string", "null"]
        },
        "approval_metadata": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "approved_at_utc",
            "approval_baseline_commit_sha",
            "approval_scope",
            "dataset_version",
            "comparison_policy"
          ],
          "properties": {
            "approved_at_utc": { "type": "string", "minLength": 1 },
            "approval_baseline_commit_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
            "approval_scope": { "const": "MVP_SYNTHETIC_REGRESSION_LOGICAL_EXPECTATIONS" },
            "dataset_version": { "type": "string", "minLength": 1 },
            "comparison_policy": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "compare_confirmed_logical_expectations",
                "enforce_zero_mutation_on_rejection",
                "excluded_unconfirmed_fields"
              ],
              "properties": {
                "compare_confirmed_logical_expectations": { "const": true },
                "enforce_zero_mutation_on_rejection": { "const": true },
                "excluded_unconfirmed_fields": {
                  "type": "array",
                  "items": { "type": "string", "minLength": 1 }
                }
              }
            }
          }
        },
        "events": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "event_id",
              "workspace_id",
              "repo_id",
              "anchor_mode",
              "lifecycle_status",
              "is_active_top_level",
              "version",
              "merge_origin",
              "origin_command_id",
              "primary_pr_id",
              "source_commit_ids",
              "context_ticket_ids",
              "member_event_ids",
              "parent_event_id",
              "membership_role",
              "searchable_as_top_level",
              "counted_in_metrics",
              "unconfirmed_fields"
            ],
            "properties": {
              "event_id": { "type": "string", "minLength": 1 },
              "workspace_id": { "type": "string" },
              "repo_id": { "type": "string" },
              "anchor_mode": {
                "type": "string",
                "enum": ["PR", "PR_SEGMENT", "DIRECT_COMMIT", "USER_COMPOSITE"]
              },
              "lifecycle_status": {
                "type": "string",
                "enum": ["CANDIDATE", "CONFIRMED", "REJECTED", "SUPERSEDED", "STALE"]
              },
              "is_active_top_level": { "type": "boolean" },
              "version": { "type": "integer", "minimum": 1 },
              "merge_origin": { "type": "string", "enum": ["NONE", "USER_MANUAL_MERGE"] },
              "origin_command_id": { "type": ["string", "null"] },
              "primary_pr_id": { "type": ["string", "null"] },
              "source_commit_ids": { "type": "array", "items": { "type": "string" } },
              "context_ticket_ids": { "type": "array", "items": { "type": "string" } },
              "member_event_ids": { "type": "array", "items": { "type": "string" } },
              "parent_event_id": { "type": ["string", "null"] },
              "membership_role": {
                "type": "string",
                "enum": ["standalone", "user_composite_root", "subsumed_by_user_composite", "split_parent", "split_child"]
              },
              "composite_membership_status": { "type": ["string", "null"], "enum": [null, "ACTIVE", "REMOVED"] },
              "member_snapshots_preserved": { "type": "boolean" },
              "reevaluation_basis": { "type": ["string", "null"] },
              "review_flags": {
                "type": "object",
                "additionalProperties": false,
                "required": ["mixed_purpose_hint_present", "exact_flag_token", "auto_split_count"],
                "properties": {
                  "mixed_purpose_hint_present": { "type": "boolean" },
                  "exact_flag_token": { "type": "string", "enum": ["UNCONFIRMED"] },
                  "auto_split_count": { "type": "integer", "const": 0 }
                }
              },
              "evidence_scope": {
                "type": "object",
                "additionalProperties": false,
                "required": ["file_paths", "diff_hunks", "review_thread_ids", "content_unit_ids"],
                "properties": {
                  "file_paths": { "type": "array", "items": { "type": "string" } },
                  "diff_hunks": { "type": "array", "items": { "type": "string" } },
                  "review_thread_ids": { "type": "array", "items": { "type": "string" } },
                  "content_unit_ids": { "type": "array", "items": { "type": "string" } }
                }
              },
              "searchable_as_top_level": { "type": "boolean" },
              "counted_in_metrics": { "type": "boolean" },
              "title_hint": { "type": "string" },
              "unconfirmed_fields": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "held_items": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "held_id",
              "record_kind",
              "source_type",
              "source_id",
              "logical_disposition",
              "spec_hold_status",
              "hold_reason",
              "interpreted_as_no_pr",
              "unconfirmed_fields"
            ],
            "properties": {
              "held_id": { "type": "string", "minLength": 1 },
              "record_kind": {
                "type": "string",
                "enum": ["OBSERVATION_RECORD", "NON_ELIGIBLE_SOURCE_RECORD"]
              },
              "source_type": { "type": "string", "enum": ["COMMIT", "PR"] },
              "source_id": { "type": "string", "minLength": 1 },
              "logical_disposition": {
                "type": "string",
                "enum": [
                  "hold_classification_unknown_assoc",
                  "not_direct_commit_candidate_non_default_branch"
                ]
              },
              "spec_hold_status": {
                "type": "string",
                "enum": ["UNCONFIRMED"]
              },
              "hold_reason": { "type": "string", "minLength": 1 },
              "interpreted_as_no_pr": { "const": false },
              "unconfirmed_fields": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "unpersisted_external_observations": {
          "type": "array",
          "description": "Post-success external observations (e.g., B-003 POST_MVP) that are NOT ingested or persisted as held records in MVP.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["observation_id", "backlog_ref", "persisted_in_mvp", "reason"],
            "properties": {
              "observation_id": { "type": "string", "pattern": "^obs_syn_[a-z0-9_]+$" },
              "backlog_ref": { "type": "string", "const": "B-003" },
              "persisted_in_mvp": { "const": false },
              "reason": { "type": "string", "minLength": 1 }
            }
          }
        },
        "command_results": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "command_id",
              "outcome",
              "rejection_category",
              "spec_error_code",
              "state_mutated",
              "resulting_event_ids",
              "unconfirmed_fields"
            ],
            "properties": {
              "command_id": { "type": "string", "minLength": 1 },
              "outcome": { "type": "string", "enum": ["ACCEPTED", "REJECTED"] },
              "rejection_category": {
                "type": ["string", "null"],
                "enum": [
                  null,
                  "non_event_or_unknown_member_rejected",
                  "nested_composite_not_allowed",
                  "member_already_composed_or_not_active",
                  "member_not_active",
                  "version_conflict",
                  "cross_repository_member",
                  "cross_workspace_merge_rejected",
                  "cross_workspace_non_merge_rejected"
                ]
              },
              "spec_error_code": {
                "type": ["string", "null"],
                "enum": [
                  null,
                  "EVENT_VERSION_CONFLICT",
                  "CROSS_WORKSPACE_MEMBER",
                  "CROSS_REPOSITORY_MEMBER",
                  "DUPLICATE_COMPOSITE_MEMBER",
                  "NESTED_COMPOSITE_NOT_ALLOWED",
                  "CANNOT_LINK_CONFLICT",
                  "MEMBER_NOT_ACTIVE",
                  "MEMBER_ALREADY_COMPOSED",
                  "PR_ASSOCIATION_INCOMPLETE",
                  "UNCONFIRMED"
                ]
              },
              "internal_policy_code": {
                "type": ["string", "null"],
                "enum": [
                  null,
                  "EVENT_VERSION_CONFLICT",
                  "CROSS_WORKSPACE_MEMBER",
                  "CROSS_REPOSITORY_MEMBER",
                  "DUPLICATE_COMPOSITE_MEMBER",
                  "NESTED_COMPOSITE_NOT_ALLOWED",
                  "CANNOT_LINK_CONFLICT",
                  "MEMBER_NOT_ACTIVE",
                  "MEMBER_ALREADY_COMPOSED",
                  "PR_ASSOCIATION_INCOMPLETE"
                ]
              },
              "candidate_error_codes": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "EVENT_VERSION_CONFLICT",
                    "CROSS_WORKSPACE_MEMBER",
                    "CROSS_REPOSITORY_MEMBER",
                    "DUPLICATE_COMPOSITE_MEMBER",
                    "NESTED_COMPOSITE_NOT_ALLOWED",
                    "CANNOT_LINK_CONFLICT",
                    "MEMBER_NOT_ACTIVE",
                    "MEMBER_ALREADY_COMPOSED",
                    "PR_ASSOCIATION_INCOMPLETE"
                  ]
                }
              },
              "state_mutated": { "type": "boolean" },
              "resulting_event_ids": { "type": "array", "items": { "type": "string" } },
              "unconfirmed_fields": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "downstream_side_effects": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "artifact_type",
              "artifact_id",
              "source_composite_event_id",
              "expected_status",
              "retroactively_deleted",
              "auto_transferred_to_members",
              "reason"
            ],
            "properties": {
              "artifact_type": { "type": "string", "enum": ["FACT", "CLAIM", "EXPORT"] },
              "artifact_id": { "type": "string", "pattern": "^(fct|clm|exp)_syn_[a-z0-9_]+$" },
              "source_composite_event_id": { "type": "string", "minLength": 1 },
              "expected_status": { "const": "STALE" },
              "retroactively_deleted": { "const": false },
              "auto_transferred_to_members": { "const": false },
              "reason": { "type": "string", "minLength": 1 }
            }
          }
        },
        "search_checks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["query", "expected_event_ids", "expected_result_count"],
            "properties": {
              "query": { "type": "string" },
              "workspace_id": { "type": "string" },
              "expected_event_ids": { "type": "array", "items": { "type": "string" } },
              "expected_result_count": { "type": "integer", "minimum": 0 }
            }
          }
        },
        "aggregation_check": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "total_countable_events",
            "total_user_composite_events",
            "total_held_items",
            "total_rejected_events"
          ],
          "properties": {
            "total_countable_events": { "type": "integer", "minimum": 0 },
            "total_user_composite_events": { "type": "integer", "minimum": 0 },
            "total_held_items": { "type": "integer", "minimum": 0 },
            "total_rejected_events": { "type": "integer", "minimum": 0 },
            "promoted_events_from_partial_runs": { "type": "integer", "const": 0 },
            "per_workspace_countable_events": {
              "type": "object",
              "additionalProperties": { "type": "integer", "minimum": 0 }
            },
            "aggregation_scope_note": { "type": "string" }
          }
        },
        "post_mvp_transition_note": { "type": ["string", "null"] },
        "review_required_items": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["field_path", "category", "status", "question"],
            "properties": {
              "field_path": { "type": "string", "minLength": 1 },
              "category": {
                "type": "string",
                "enum": ["UNCONFIRMED_SPEC_TOKEN", "TRULY_UNDECIDED_BEHAVIOR"]
              },
              "status": {
                "type": "string",
                "enum": ["REVIEW_REQUIRED", "EXCLUDED_FROM_MVP_TRUTH_COMPARISON"]
              },
              "question": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "rationale": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary",
        "confirmed_spec_rules",
        "unconfirmed_spec_tokens",
        "truly_undecided_items"
      ],
      "properties": {
        "summary": { "type": "string", "minLength": 1 },
        "confirmed_spec_rules": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "unconfirmed_spec_tokens": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "truly_undecided_items": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}

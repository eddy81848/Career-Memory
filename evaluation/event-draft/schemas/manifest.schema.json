{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://career-memory.example.invalid/schemas/event-draft-manifest.v1.json",
  "title": "Career Memory T-001A Event Synthetic Dataset Draft Manifest",
  "description": "Manifest schema for T-001A synthetic Event fixtures and draft expected proposals. Separates local draft tracking IDs from official FR/EVENT traceability refs. Logical domain contract only (no OD-007 physical table assumptions).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "dataset_id",
    "task_ref",
    "approval_status",
    "base_commit_sha",
    "scope_boundary",
    "generation_provenance",
    "reference_docs",
    "cases",
    "negative_variants"
  ],
  "properties": {
    "schema_version": {
      "const": "event-draft-manifest.v1"
    },
    "dataset_id": {
      "type": "string",
      "minLength": 1
    },
    "task_ref": {
      "const": "T-001A"
    },
    "approval_status": {
      "const": "DRAFT",
      "description": "Agent-authored dataset must remain DRAFT until independent human review and freeze in T-001B."
    },
    "base_commit_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "scope_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "includes",
        "excludes",
        "od_007_physical_table_assumption",
        "synthetic_only"
      ],
      "properties": {
        "includes": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "excludes": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "od_007_physical_table_assumption": {
          "const": false
        },
        "synthetic_only": {
          "const": true
        }
      }
    },
    "generation_provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "generation_method",
        "agent_role",
        "model_identifier",
        "prompt_source",
        "generated_at_utc",
        "external_api_calls",
        "seed_reproducibility"
      ],
      "properties": {
        "generation_method": { "type": "string", "minLength": 1 },
        "agent_role": { "type": "string", "minLength": 1 },
        "model_identifier": { "type": "string", "minLength": 1 },
        "prompt_source": { "type": "string", "minLength": 1 },
        "generated_at_utc": { "type": "string", "format": "date-time" },
        "external_api_calls": {
          "type": "object",
          "additionalProperties": false,
          "required": ["github_api", "llm_api_from_script", "notion_api"],
          "properties": {
            "github_api": { "const": 0 },
            "llm_api_from_script": { "const": 0 },
            "notion_api": { "const": 0 }
          }
        },
        "seed_reproducibility": {
          "type": "object",
          "additionalProperties": false,
          "required": ["deterministic_seed_available", "limitation_note"],
          "properties": {
            "deterministic_seed_available": { "type": "boolean" },
            "limitation_note": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "reference_docs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "url", "access_status", "note"],
        "properties": {
          "name": { "type": "string" },
          "url": { "type": "string" },
          "access_status": {
            "type": "string",
            "enum": ["READ", "REVIEW_SPEC_BRIEF", "UNAVAILABLE_AUTH_REQUIRED", "LOCAL_REPO_ONLY"]
          },
          "note": { "type": "string" }
        }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_id",
          "path",
          "scope",
          "review_status",
          "draft_requirement_ids",
          "draft_test_ids",
          "official_requirement_refs",
          "official_test_refs"
        ],
        "properties": {
          "case_id": {
            "type": "string",
            "pattern": "^EV-[0-9]{3}$"
          },
          "path": { "type": "string", "pattern": "^cases/EV-[0-9]{3}-.+\\.json$" },
          "scope": { "type": "string", "enum": ["MVP", "POST_MVP"] },
          "backlog_ref": { "type": ["string", "null"] },
          "review_status": {
            "type": "string",
            "enum": ["PENDING_HUMAN_REVIEW", "REVIEW_REQUIRED"]
          },
          "draft_requirement_ids": {
            "type": "array",
            "items": { "type": "string" },
            "minItems": 1
          },
          "draft_test_ids": {
            "type": "array",
            "items": { "type": "string" },
            "minItems": 1
          },
          "official_requirement_refs": {
            "type": "array",
            "items": { "type": "string", "enum": ["FR-006", "FR-007"] }
          },
          "official_test_refs": {
            "type": "array",
            "items": { "type": "string", "enum": ["EVENT-10", "EVENT-11", "EVENT-12"] }
          }
        }
      }
    },
    "negative_variants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "variant_id",
          "path",
          "expected_rule_codes",
          "purpose"
        ],
        "properties": {
          "variant_id": {
            "type": "string",
            "pattern": "^NEG-[0-9]{3}$"
          },
          "path": {
            "type": "string",
            "pattern": "^negative-fixtures/NEG-[0-9]{3}-.+\\.json$"
          },
          "expected_rule_codes": {
            "type": "array",
            "items": { "type": "string" },
            "minItems": 1
          },
          "purpose": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}

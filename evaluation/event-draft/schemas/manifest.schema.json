{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://career-memory.example.invalid/schemas/event-draft-manifest.v1.json",
  "title": "Career Memory Event Synthetic Dataset Manifest (T-001A/T-001B)",
  "description": "Manifest schema for Event synthetic fixtures covering human-approved MVP synthetic regression ground truth (EV-001..EV-016), unapproved Post-MVP B-003 drafts (EV-017..EV-018), same-source evaluation bundles, isolated negative fixtures (NEG-001..NEG-006), and SHA-256 integrity hashes. Logical domain contract only (no OD-007 physical table assumptions).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "dataset_id",
    "dataset_version",
    "task_ref",
    "approval_status",
    "base_commit_sha",
    "approval_record",
    "scope_boundary",
    "generation_provenance",
    "reference_docs",
    "evaluation_bundles",
    "integrity_hashes",
    "cases",
    "negative_variants"
  ],
  "properties": {
    "schema_version": {
      "const": "event-draft-manifest.v1"
    },
    "dataset_id": {
      "type": "string",
      "minLength": 1
    },
    "dataset_version": {
      "type": "string",
      "minLength": 1
    },
    "task_ref": {
      "type": "string",
      "enum": ["T-001A", "T-001B"]
    },
    "approval_status": {
      "type": "string",
      "enum": ["DRAFT", "PARTIALLY_APPROVED_MVP_REGRESSION"],
      "description": "PARTIALLY_APPROVED_MVP_REGRESSION indicates EV-001..EV-016 confirmed logical expectations are approved for MVP synthetic regression while EV-017..EV-018 remain Post-MVP DRAFT."
    },
    "base_commit_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "approval_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "approved_by",
        "approved_at_utc",
        "approval_baseline_commit_sha",
        "base_main_commit_sha",
        "approval_scope",
        "approved_case_ids",
        "unapproved_post_mvp_draft_case_ids",
        "excluded_negative_variant_ids",
        "comparison_policy"
      ],
      "properties": {
        "approved_by": { "type": "string", "minLength": 1 },
        "approved_at_utc": { "type": "string", "minLength": 1 },
        "approval_baseline_commit_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "base_main_commit_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "approval_scope": { "type": "string", "minLength": 1 },
        "approved_case_ids": {
          "type": "array",
          "items": { "type": "string", "pattern": "^EV-[0-9]{3}$" },
          "minItems": 16
        },
        "unapproved_post_mvp_draft_case_ids": {
          "type": "array",
          "items": { "type": "string", "pattern": "^EV-[0-9]{3}$" }
        },
        "excluded_negative_variant_ids": {
          "type": "array",
          "items": { "type": "string", "pattern": "^NEG-[0-9]{3}$" },
          "minItems": 1
        },
        "comparison_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "compare_confirmed_logical_expectations",
            "enforce_zero_mutation_on_rejection",
            "excluded_from_truth_comparison",
            "retained_mandatory_rejection_checks"
          ],
          "properties": {
            "compare_confirmed_logical_expectations": { "const": true },
            "enforce_zero_mutation_on_rejection": { "const": true },
            "excluded_from_truth_comparison": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 },
              "minItems": 1
            },
            "retained_mandatory_rejection_checks": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 },
              "minItems": 1
            }
          }
        }
      }
    },
    "scope_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "includes",
        "excludes",
        "od_007_physical_table_assumption",
        "synthetic_only"
      ],
      "properties": {
        "includes": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "excludes": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "od_007_physical_table_assumption": {
          "const": false
        },
        "synthetic_only": {
          "const": true
        }
      }
    },
    "generation_provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "generation_method",
        "agent_role",
        "model_identifier",
        "prompt_source",
        "generated_at_utc",
        "external_api_calls",
        "seed_reproducibility"
      ],
      "properties": {
        "generation_method": { "type": "string", "minLength": 1 },
        "agent_role": { "type": "string", "minLength": 1 },
        "model_identifier": { "type": "string", "minLength": 1 },
        "prompt_source": { "type": "string", "minLength": 1 },
        "generated_at_utc": { "type": "string", "format": "date-time" },
        "external_api_calls": {
          "type": "object",
          "additionalProperties": false,
          "required": ["github_api", "llm_api_from_script", "notion_api"],
          "properties": {
            "github_api": { "const": 0 },
            "llm_api_from_script": { "const": 0 },
            "notion_api": { "const": 0 }
          }
        },
        "seed_reproducibility": {
          "type": "object",
          "additionalProperties": false,
          "required": ["deterministic_seed_available", "limitation_note"],
          "properties": {
            "deterministic_seed_available": { "type": "boolean" },
            "limitation_note": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "reference_docs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "url", "access_status", "note"],
        "properties": {
          "name": { "type": "string" },
          "url": { "type": "string" },
          "access_status": {
            "type": "string",
            "enum": ["READ", "REVIEW_SPEC_BRIEF", "UNAVAILABLE_AUTH_REQUIRED", "LOCAL_REPO_ONLY"]
          },
          "note": { "type": "string" }
        }
      }
    },
    "evaluation_bundles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "eval_bundle_id",
          "eval_partition",
          "source_lineage_groups",
          "shared_synthetic_repositories",
          "case_ids",
          "rationale"
        ],
        "properties": {
          "eval_bundle_id": { "type": "string", "minLength": 1 },
          "eval_partition": {
            "type": "string",
            "enum": ["MVP_SYNTHETIC_REGRESSION", "POST_MVP_DRAFT_EXCLUDED"]
          },
          "source_lineage_groups": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "minItems": 1
          },
          "shared_synthetic_repositories": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "minItems": 1
          },
          "case_ids": {
            "type": "array",
            "items": { "type": "string", "pattern": "^EV-[0-9]{3}$" },
            "minItems": 1
          },
          "rationale": { "type": "string", "minLength": 1 }
        }
      }
    },
    "integrity_hashes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hash_algorithm",
        "baseline_commit_sha",
        "approved_mvp_bundle_sha256",
        "approved_mvp_baseline_bundle_sha256",
        "post_mvp_draft_bundle_sha256",
        "schema_files_sha256",
        "approved_mvp_cases_sha256",
        "post_mvp_draft_cases_sha256"
      ],
      "properties": {
        "hash_algorithm": { "const": "sha256" },
        "baseline_commit_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "approved_mvp_bundle_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "approved_mvp_baseline_bundle_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "post_mvp_draft_bundle_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "schema_files_sha256": {
          "type": "object",
          "additionalProperties": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        },
        "approved_mvp_cases_sha256": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "file_sha256", "baseline_sha256_at_0773ac5"],
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "file_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
              "baseline_sha256_at_0773ac5": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
            }
          }
        },
        "post_mvp_draft_cases_sha256": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "file_sha256", "baseline_sha256_at_0773ac5"],
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "file_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
              "baseline_sha256_at_0773ac5": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
            }
          }
        }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_id",
          "path",
          "scope",
          "review_status",
          "approval_status",
          "eval_bundle_id",
          "source_lineage_group",
          "eval_partition",
          "file_sha256",
          "draft_requirement_ids",
          "draft_test_ids",
          "official_requirement_refs",
          "official_test_refs"
        ],
        "properties": {
          "case_id": {
            "type": "string",
            "pattern": "^EV-[0-9]{3}$"
          },
          "path": { "type": "string", "pattern": "^cases/EV-[0-9]{3}-.+\\.json$" },
          "scope": { "type": "string", "enum": ["MVP", "POST_MVP"] },
          "backlog_ref": { "type": ["string", "null"] },
          "review_status": {
            "type": "string",
            "enum": ["PENDING_HUMAN_REVIEW", "REVIEW_REQUIRED", "APPROVED_MVP_REGRESSION"]
          },
          "approval_status": {
            "type": "string",
            "enum": ["DRAFT", "APPROVED_MVP_REGRESSION"]
          },
          "eval_bundle_id": { "type": "string", "minLength": 1 },
          "source_lineage_group": { "type": "string", "minLength": 1 },
          "eval_partition": {
            "type": "string",
            "enum": ["MVP_SYNTHETIC_REGRESSION", "POST_MVP_DRAFT_EXCLUDED"]
          },
          "file_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "draft_requirement_ids": {
            "type": "array",
            "items": { "type": "string" },
            "minItems": 1
          },
          "draft_test_ids": {
            "type": "array",
            "items": { "type": "string" },
            "minItems": 1
          },
          "official_requirement_refs": {
            "type": "array",
            "items": { "type": "string", "enum": ["FR-006", "FR-007"] }
          },
          "official_test_refs": {
            "type": "array",
            "items": { "type": "string", "enum": ["EVENT-10", "EVENT-11", "EVENT-12"] }
          }
        }
      }
    },
    "negative_variants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "variant_id",
          "path",
          "eval_excluded",
          "expected_rule_codes",
          "purpose"
        ],
        "properties": {
          "variant_id": {
            "type": "string",
            "pattern": "^NEG-[0-9]{3}$"
          },
          "path": {
            "type": "string",
            "pattern": "^negative-fixtures/NEG-[0-9]{3}-.+\\.json$"
          },
          "eval_excluded": { "const": true },
          "expected_rule_codes": {
            "type": "array",
            "items": { "type": "string" },
            "minItems": 1
          },
          "purpose": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
